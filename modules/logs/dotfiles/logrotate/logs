# NOTE:
# /var/log/boot.log and /var/log/snapper.log are already handled by
# distro-provided logrotate configs (bootlog, snapper).
# Keep this file conflict-free to avoid duplicate entry errors.
/var/log/pacman.log {
    weekly
    rotate 8
    size 10M
    compress
    delaycompress
    missingok
    notifempty
    create 640 root root
}

/var/log/mullvad-vpn/*.log {
    weekly
    rotate 6
    size 5M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
