#!/bin/sh
exec tail -n +3 $0
# Cross-install GRUB jump entries for dual CachyOS setup.
# Use each install's own grub.cfg via `configfile` (not kernel stanzas).

submenu "CachyOS installs (cross-GRUB)" {
    menuentry "CachyOS (nvme1n1p2, UUID 3f8b9c99-b595-464c-8aad-65c406da06de)" {
        insmod part_gpt
        insmod btrfs
        search --no-floppy --fs-uuid --set=root 3f8b9c99-b595-464c-8aad-65c406da06de
        if [ -f /@/boot/grub/grub.cfg ]; then
            configfile /@/boot/grub/grub.cfg
        elif [ -f /boot/grub/grub.cfg ]; then
            configfile /boot/grub/grub.cfg
        else
            echo "grub.cfg not found on nvme1n1p2"
            sleep 3
        fi
    }

    menuentry "CachyOS (nvme0n1p1, UUID 8a26da5e-603a-4895-ab78-b273d9e1fde4)" {
        insmod part_gpt
        insmod btrfs
        search --no-floppy --fs-uuid --set=root 8a26da5e-603a-4895-ab78-b273d9e1fde4
        if [ -f /@/boot/grub/grub.cfg ]; then
            configfile /@/boot/grub/grub.cfg
        elif [ -f /boot/grub/grub.cfg ]; then
            configfile /boot/grub/grub.cfg
        else
            echo "grub.cfg not found on nvme0n1p1"
            sleep 3
        fi
    }

    menuentry "CachyOS Rog (sda1, EFI UUID 6880-73B3)" {
        insmod part_gpt
        insmod fat
        search --no-floppy --fs-uuid --set=root 6880-73B3
        chainloader /EFI/cachyos/grubx64.efi
    }

    menuentry "CachyOS EFI fallback (ESP 9287-D3F5)" {
        insmod part_gpt
        insmod fat
        search --no-floppy --fs-uuid --set=root 9287-D3F5
        chainloader /EFI/cachyos/grubx64.efi
    }
}
