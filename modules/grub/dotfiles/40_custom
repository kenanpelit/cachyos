#!/bin/sh
exec tail -n +3 $0
# Cross-install GRUB jump entries for dual CachyOS setup.
# NOTE:
# - /etc/grub.d/40_custom is autogenerated by modules/grub/scripts/install.sh
# - this file is a reference fallback kept in-repo.

submenu "CachyOS installs (cross-GRUB)" {
    menuentry "Regenerate cross-GRUB entries (run install.sh)" {
        echo "Run as root: modules/grub/scripts/install.sh"
        sleep 2
    }

    menuentry "CachyOS Rog (sda1, EFI UUID 6880-73B3)" {
        insmod part_gpt
        insmod fat
        search --no-floppy --fs-uuid --set=root 6880-73B3
        chainloader /EFI/cachyos/grubx64.efi
    }

    menuentry "CachyOS EFI fallback (ESP 9287-D3F5)" {
        insmod part_gpt
        insmod fat
        search --no-floppy --fs-uuid --set=root 9287-D3F5
        chainloader /EFI/cachyos/grubx64.efi
    }
}
