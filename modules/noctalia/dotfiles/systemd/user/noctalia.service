[Unit]
Description=Noctalia Shell
# Zero-Wait: Bootstrap beklemeden anında başla
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Environment=QS_CACHE_DIR=%t/noctalia-qml-cache
# High-Priority: Ensure the shell gets CPU time immediately
Nice=-15
CPUWeight=500
TimeoutStartSec=120

# Fast-Precheck: Reduced sleep to 100ms for minimum delay
ExecStartPre=/usr/bin/sh -c 'for i in {1..20}; do [ -f %h/.config/noctalia/settings.json ] && exit 0; sleep 0.1; done; exit 0'
ExecStartPre=/usr/bin/sh -c 'mkdir -p %h/.config/noctalia/plugins/clipper/notecards && [ -f %h/.config/noctalia/plugins/clipper/pinned.json ] || printf "%s\n" "{\"items\":[]}" > %h/.config/noctalia/plugins/clipper/pinned.json'

ExecCondition=/usr/bin/sh -c 'case "${XDG_CURRENT_DESKTOP:-}" in niri|Hyprland) : ;; *) exit 1 ;; esac; backend="$(osc-shell backend 2>/dev/null || echo noctalia)"; [ "$backend" = "noctalia" ]'
ExecStart=/usr/bin/qs -c noctalia-shell --no-duplicate
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
