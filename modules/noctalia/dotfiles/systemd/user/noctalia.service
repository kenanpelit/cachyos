[Unit]
Description=Noctalia Shell
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
# Niri'nin tam oturması için niri-ready'den sonra 1-2 saniye daha pay bırakıyoruz
After=niri-ready.service
PartOf=graphical-session.target

[Service]
Environment=QS_CACHE_DIR=%t/noctalia-qml-cache
# Noctalia'nın açılışta ölmemesi için zaman aşımını artırıyoruz
TimeoutStartSec=120
# CPU önceliğini artırarak eklentilerin yüklenmesini hızlandırıyoruz
CPUWeight=200
StartupCPUShares=2048

ExecCondition=/usr/bin/sh -c 'backend="$(osc-shell backend 2>/dev/null || echo noctalia)"; [ "$backend" = "noctalia" ]'
ExecStart=/usr/bin/qs -c noctalia-shell --no-duplicate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
