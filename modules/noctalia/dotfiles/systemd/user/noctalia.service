[Unit]
Description=Noctalia Shell
# Systemd ile değil, Niri config içinden doğrudan başlatılıyor.
# Bu servis sadece manuel kontrol veya restart senaryoları için duruyor.
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/qs -c noctalia-shell --no-duplicate
Restart=on-failure
RestartSec=1

# [Install] silindi - Otomatik başlama Niri config üzerinden yapılıyor.
