[Unit]
Description=Noctalia Shell
ConditionEnvironment=WAYLAND_DISPLAY
After=graphical-session.target niri-bootstrap.service niri-daemons.target hyprland-session.target
PartOf=niri-daemons.target hyprland-session.target

[Service]
Environment=QS_CACHE_DIR=%t/noctalia-qml-cache
ExecCondition=/usr/bin/bash -lc 'backend="$("%h/.local/bin/osc-shell" backend 2>/dev/null || osc-shell backend 2>/dev/null || echo noctalia)"; [[ "$backend" == "noctalia" ]]'
ExecStart=/usr/bin/qs -c noctalia-shell --no-duplicate
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri-daemons.target hyprland-session.target
