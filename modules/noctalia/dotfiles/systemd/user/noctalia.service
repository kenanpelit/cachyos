[Unit]
Description=Noctalia Shell
After=graphical-session.target hypr-session-env.service hypr-bootstrap.service niri-session-env.service niri-bootstrap.service mango-session-env.service mango-bootstrap.service
PartOf=graphical-session.target hyprland-session.target niri-session.target mangowm-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Environment=QS_CACHE_DIR=%C/noctalia-qml-cache
# High-Priority: Ensure the shell gets CPU time immediately
Nice=-15
CPUWeight=500
TimeoutStartSec=120

# Fast-Precheck: Reduced sleep to 100ms for minimum delay
ExecStartPre=%h/.local/bin/noctalia-preflight

ExecCondition=%h/.local/bin/noctalia-should-start
ExecStart=%h/.local/bin/noctalia-launch
Restart=on-failure
RestartSec=1
