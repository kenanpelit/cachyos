[Unit]
Description=Noctalia Shell
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
# Tie lifecycle to Niri daemon stage.
After=niri-bootstrap.service niri-daemons.target
BindsTo=niri-daemons.target
PartOf=niri-daemons.target

[Service]
Environment=QS_CACHE_DIR=%t/noctalia-qml-cache
ExecStart=/usr/bin/qs -c noctalia-shell --no-duplicate
Restart=on-failure
RestartSec=1

[Install]
WantedBy=niri-daemons.target
