[Unit]
Description=Noctalia Shell
After=graphical-session.target hypr-bootstrap.service niri-bootstrap.service
PartOf=graphical-session.target hyprland-session.target niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Environment=QS_CACHE_DIR=%t/noctalia-qml-cache
Environment=XDG_ICON_THEME=kora
Environment=ICON_THEME=kora
Environment=QT_ICON_THEME=kora
# High-Priority: Ensure the shell gets CPU time immediately
Nice=-15
CPUWeight=500
TimeoutStartSec=120

# Fast-Precheck: Reduced sleep to 100ms for minimum delay
ExecStartPre=%h/.local/bin/noctalia-preflight

ExecCondition=%h/.local/bin/noctalia-should-start
ExecStart=%h/.local/bin/noctalia-launch
Restart=on-failure
RestartSec=1

[Install]
WantedBy=hyprland-session.target
WantedBy=niri-session.target
