{
  "cheatsheetData": [
    {
      "title": "Unsupported Compositor",
      "binds": [
        {
          "keys": "UNKNOWN",
          "desc": "Unknown compositor detected"
        },
        {
          "keys": "INFO",
          "desc": "This plugin only supports Hyprland and Niri compositors"
        }
      ]
    }
  ],
  "detectedCompositor": "unknown",
  "windowWidth": 1440,
