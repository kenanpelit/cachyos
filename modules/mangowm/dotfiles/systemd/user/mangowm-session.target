[Unit]
Description=MangoWM session (user services)
Documentation=man:systemd.special(7)
Wants=graphical-session.target xdg-desktop-autostart.target mango-session-env.service mango-bootstrap.service mango-audio-init.service mango-shell-ensure.service mango-daemons.target mango-post-daemons.target
After=graphical-session.target dbus.service
BindsTo=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_DESKTOP=mango
