[Unit]
Description=MangoWM initial tag arrangement
After=mango-bootstrap.service mango-session-env.service
PartOf=mangowm-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=mango
ConditionPathExists=%h/.local/bin/mango-arrange

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/mango-arrange
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
