[Unit]
Description=MangoWM lid switch inhibitor
After=graphical-session.target wayland-wm@mango\x2dsession.service dbus.service
PartOf=mangowm-session.target
ConditionEnvironment=XDG_SESSION_DESKTOP=mango

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --who=MangoWM --why=lock-before-suspend-on-lid-close /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
