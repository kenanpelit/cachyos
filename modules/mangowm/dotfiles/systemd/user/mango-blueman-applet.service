[Unit]
Description=Blueman applet (MangoWM)
BindsTo=wayland-wm@mango\x2dsession.service
Wants=mango-status-notifier-ready.service
After=graphical-session.target wayland-wm@mango\x2dsession.service mango-bootstrap.service mango-status-notifier-ready.service dbus.service
PartOf=mango-daemons.target graphical-session.target wayland-wm@mango\x2dsession.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=mango

[Service]
Type=simple
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
Environment="BLUEMAN_PLUGIN_LIST=['!TransferService', '!GameControllerWakelock', '!PPPSupport', '!DhcpClient']"
Environment=GDK_BACKEND=wayland,x11
ExecStart=%h/.local/bin/mango-blueman-applet
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mango-daemons.target
