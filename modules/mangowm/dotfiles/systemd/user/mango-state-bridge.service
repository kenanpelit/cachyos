[Unit]
Description=MangoWM IPC state bridge
BindsTo=wayland-wm@mango\x2dsession.service
After=graphical-session.target wayland-wm@mango\x2dsession.service mango-bootstrap.service
PartOf=mango-daemons.target graphical-session.target wayland-wm@mango\x2dsession.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=mango
ConditionPathExists=%h/.local/bin/mango-state-bridge

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/mango-state-bridge --watch
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mango-daemons.target
