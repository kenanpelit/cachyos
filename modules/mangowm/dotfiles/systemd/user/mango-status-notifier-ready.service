[Unit]
Description=MangoWM status notifier watcher readiness gate
After=graphical-session.target mango-bootstrap.service mango-shell-ensure.service dbus.service
PartOf=mangowm-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=mango
ConditionPathExists=%h/.local/bin/status-notifier-ready

[Service]
Type=oneshot
TimeoutStartSec=25
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=STATUS_NOTIFIER_READY_LOG_TAG=mango-status-notifier-ready
Environment=STATUS_NOTIFIER_READY_SLEEP_SECS=0.25
ExecStart=%h/.local/bin/status-notifier-ready
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
