[Unit]
Description=MangoWM session runtime environment sync
After=graphical-session.target wayland-wm@mango\x2dsession.service wayland-session-waitenv.service dbus.service
Before=mango-bootstrap.service mango-audio-init.service mango-shell-ensure.service mango-daemons.target mango-post-daemons.target
PartOf=mangowm-session.target
ConditionEnvironment=XDG_SESSION_DESKTOP=mango
ConditionPathExists=%h/.local/bin/mango-session-init

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/mango-session-init --no-start-target
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
