[Unit]
Description=MangoWM desktop settings sync
After=mango-daemons.target mango-audio-init.service dbus.service
PartOf=mangowm-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=mango
ConditionPathExists=%h/.local/bin/mango-desktop-settings

[Service]
Type=oneshot
TimeoutStartSec=20
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/mango-desktop-settings
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mango-post-daemons.target
