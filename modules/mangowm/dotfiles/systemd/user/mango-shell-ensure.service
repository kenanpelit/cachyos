[Unit]
Description=MangoWM shell backend ensure
After=mango-bootstrap.service dbus.service
Before=mango-status-notifier-ready.service
PartOf=mangowm-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=mango
ConditionPathExists=%h/.local/bin/osc-shell

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=OSC_SHELL_STARTUP=1
ExecStart=%h/.local/bin/osc-shell ensure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
