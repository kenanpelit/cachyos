[Unit]
Description=MangoWM bootstrap (init)
Wants=pipewire.service wireplumber.service
After=graphical-session.target wayland-wm@mango-session.service wayland-session-waitenv.service mango-session-env.service pipewire.service wireplumber.service
Before=mango-audio-init.service mango-shell-ensure.service mango-daemons.target
PartOf=mangowm-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=mango
ConditionPathExists=%h/.local/bin/mango-bootstrap

[Service]
Type=oneshot
TimeoutStartSec=60
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/mango-bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=mangowm-session.target
