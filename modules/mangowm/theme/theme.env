# Canonical MangoWM theme manifest.
# Regenerate derived files with:
#   modules/mangowm/scripts/render-theme.sh
#   modules/mangowm/scripts/render-packages.sh

# Package/backend profile:
# - full-stable: mangowm (scenefx-capable distro package)
# - full-git: mangowm-git (scenefx-capable AUR/git package)
# - wlonly-git: mangowm-wlonly-git (wlroots 2.0, no scenefx effects parsing)
MANGO_PACKAGE_VARIANT=full-stable

MANGO_CURSOR_SIZE=24

MANGO_BLUR=1
MANGO_BLUR_LAYER=0
MANGO_BLUR_OPTIMIZED=1
MANGO_BLUR_PASSES=2
MANGO_BLUR_RADIUS=5
MANGO_BLUR_NOISE=0.02
MANGO_BLUR_BRIGHTNESS=0.90
MANGO_BLUR_CONTRAST=0.90
MANGO_BLUR_SATURATION=1.20

MANGO_SHADOWS=1
MANGO_LAYER_SHADOWS=0
MANGO_SHADOW_ONLY_FLOATING=1
MANGO_SHADOWS_SIZE=16
MANGO_SHADOWS_BLUR=24
MANGO_SHADOWS_POSITION_X=0
MANGO_SHADOWS_POSITION_Y=4
MANGO_SHADOW_COLOR=0x11111b99

MANGO_BORDER_RADIUS=12
MANGO_NO_RADIUS_WHEN_SINGLE=0
MANGO_FOCUSED_OPACITY=1.0
MANGO_UNFOCUSED_OPACITY=1.0

MANGO_ANIMATIONS=1
MANGO_LAYER_ANIMATIONS=1
# Use subtle zoom for normal windows, but keep layer surfaces on slide so
# large shell panels do not "pop" from the center.
MANGO_ANIMATION_TYPE_OPEN=zoom
MANGO_ANIMATION_TYPE_CLOSE=fade
MANGO_LAYER_ANIMATION_TYPE_OPEN=slide
MANGO_LAYER_ANIMATION_TYPE_CLOSE=slide
MANGO_ANIMATION_FADE_IN=1
MANGO_ANIMATION_FADE_OUT=1
# Keep tag transitions vertical to match the workspace flow.
MANGO_TAG_ANIMATION_DIRECTION=0
MANGO_ZOOM_INITIAL_RATIO=0.94
MANGO_ZOOM_END_RATIO=0.94
MANGO_FADEIN_BEGIN_OPACITY=0.72
MANGO_FADEOUT_BEGIN_OPACITY=1.0
MANGO_ANIMATION_DURATION_MOVE=220
MANGO_ANIMATION_DURATION_OPEN=180
# Keep tag changes readable, but do not let them drag behind the input.
MANGO_ANIMATION_DURATION_TAG=280
MANGO_ANIMATION_DURATION_CLOSE=160
MANGO_ANIMATION_DURATION_FOCUS=0
# Stick close to Mango's documented defaults for curves; they are predictable
# and avoid the over-snappy feel of harder ease-outs.
MANGO_ANIMATION_CURVE_OPEN=0.46,1.0,0.29,0.99
MANGO_ANIMATION_CURVE_MOVE=0.46,1.0,0.29,0.99
MANGO_ANIMATION_CURVE_TAG=0.46,1.0,0.29,0.99
MANGO_ANIMATION_CURVE_CLOSE=0.46,1.0,0.29,0.99
MANGO_ANIMATION_CURVE_FOCUS=0.46,1.0,0.29,0.99
MANGO_ANIMATION_CURVE_OPAFADEOUT=0.5,0.5,0.5,0.5
MANGO_ANIMATION_CURVE_OPAFADEIN=0.46,1.0,0.29,0.99

MANGO_GAP_INNER_H=6
MANGO_GAP_INNER_V=6
MANGO_GAP_OUTER_H=6
MANGO_GAP_OUTER_V=6
MANGO_SCRATCHPAD_WIDTH_RATIO=0.80
MANGO_SCRATCHPAD_HEIGHT_RATIO=0.88
MANGO_BORDER_PX=3

MANGO_ROOT_COLOR=0x1e1e2eff
MANGO_BORDER_COLOR=0x313244ff
MANGO_FOCUS_COLOR=0xcba6f7ff
MANGO_MAXIMIZE_COLOR=0x89b4faff
MANGO_URGENT_COLOR=0xf38ba8ff
MANGO_SCRATCHPAD_COLOR=0x74c7ecff
MANGO_GLOBAL_COLOR=0x89dcebff
MANGO_OVERLAY_COLOR=0xa6e3a1ff
