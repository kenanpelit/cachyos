#!/usr/bin/env bash
set -euo pipefail

log_error() {
  local message="$1"
  echo "$message" >&2
  if command -v logger >/dev/null 2>&1; then
    logger -t fusuma-helper -- "$message"
  fi
}

detect_compositor() {
  case "${FUSUMA_COMPOSITOR:-}" in
    niri|hyprland)
      echo "${FUSUMA_COMPOSITOR}"
      return 0
      ;;
  esac

  if [[ -n "${NIRI_SOCKET:-}" && -S "${NIRI_SOCKET}" ]]; then
    echo "niri"
    return 0
  fi

  case "${XDG_CURRENT_DESKTOP:-}${XDG_SESSION_DESKTOP:-}" in
    *niri*|*Niri*)
      echo "niri"
      return 0
      ;;
    *Hyprland*|*hyprland*)
      echo "hyprland"
      return 0
      ;;
  esac

  if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    local runtime_dir hypr_socket
    runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    hypr_socket="$runtime_dir/hypr/${HYPRLAND_INSTANCE_SIGNATURE}/.socket.sock"
    if [[ -S "$hypr_socket" ]]; then
      echo "hyprland"
      return 0
    fi
  fi

  return 1
}

compositor="$(detect_compositor || true)"

if [[ "$compositor" == "hyprland" ]]; then
  if command -v hypr-expo >/dev/null 2>&1; then
    exec hypr-expo toggle
  fi
  if command -v osc-shell >/dev/null 2>&1; then
    exec osc-shell ipc call launcher windows
  fi
  log_error "fusuma-overview: no overview backend found"
  exit 127
fi

# Niri has built-in gestures for overview; avoid double-triggering.
exit 0
