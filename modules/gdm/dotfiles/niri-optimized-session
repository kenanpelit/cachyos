#!/usr/bin/env bash
# ==============================================================================
# Script: niri-optimized-session
# Description: High-performance session launcher for GDM. 
#              Combines early env injection with native niri-session speed.
# ==============================================================================
set -euo pipefail

# 1. Pre-warm: Inject basic session identity into systemd immediately.
# This ensures services like Noctalia see these variables on their very first breath.
if command -v systemctl >/dev/null 2>&1; then
  systemctl --user set-environment \
    XDG_CURRENT_DESKTOP=niri \
    XDG_SESSION_DESKTOP=niri \
    XDG_SESSION_TYPE=wayland \
    DESKTOP_SESSION=niri \
    NOCTALIA_STARTUP_HINT=1 >/dev/null 2>&1 || true
fi

# 2. Fast-track: Bypass niri-osc TTY logic when running under a Display Manager.
# We go straight to niri-session for the 1-2 second startup experience.
if command -v niri-session >/dev/null 2>&1; then
  exec niri-session
fi

# Fallback to direct binary if niri-session is missing
exec niri --session
