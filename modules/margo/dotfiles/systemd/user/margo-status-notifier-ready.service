[Unit]
Description=Margo status notifier watcher readiness gate
After=graphical-session.target margo-shell-ensure.service dbus.service
PartOf=margo-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=margo
ConditionPathExists=%h/.local/bin/status-notifier-ready

[Service]
Type=oneshot
TimeoutStartSec=25
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=STATUS_NOTIFIER_READY_LOG_TAG=margo-status-notifier-ready
Environment=STATUS_NOTIFIER_READY_SLEEP_SECS=0.25
ExecStart=%h/.local/bin/status-notifier-ready
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=margo-session.target
