# margo ships its own in-process polkit agent: mshell-polkit, started by
# the mshell process (mshell-core registers it for the logind Display
# session). Running polkit-gnome here as a SECOND agent made the two fight
# over the session — polkit-gnome won and popped an unthemed dialog that
# did not fit its window. This unit is intentionally neutered so the only
# polkit agent is mshell's.
#
# To apply on the running session:
#   systemctl --user daemon-reload
#   systemctl --user disable --now margo-polkit-agent.service
#   systemctl --user restart mshell      # mshell-polkit grabs the session
[Unit]
Description=Polkit agent (disabled — margo uses mshell's in-process agent)
# Belt-and-suspenders: never execute, even if something still pulls this
# unit in as a dependency.
ConditionPathExists=/nonexistent

[Service]
Type=oneshot
ExecStart=/bin/true
