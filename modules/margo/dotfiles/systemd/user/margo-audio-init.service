[Unit]
Description=Margo audio initialization
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service
PartOf=margo-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=margo
ConditionPathExists=%h/.local/bin/osc-soundctl

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=TERM=dumb
ExecStart=%h/.local/bin/osc-soundctl init
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=margo-session.target
