[Unit]
Description=NetworkManager applet (Margo)
BindsTo=wayland-wm@margo\x2dsession.service
Wants=margo-status-notifier-ready.service
After=graphical-session.target wayland-wm@margo\x2dsession.service margo-status-notifier-ready.service dbus.service
PartOf=margo-daemons.target graphical-session.target wayland-wm@margo\x2dsession.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=margo

[Service]
Type=simple
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
Environment=GDK_BACKEND=wayland,x11
ExecStart=/usr/bin/nm-applet --indicator
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=margo-daemons.target
