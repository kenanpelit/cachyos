[Unit]
Description=Margo lid switch inhibitor
After=graphical-session.target wayland-wm@margo\x2dsession.service dbus.service
PartOf=margo-session.target
ConditionEnvironment=XDG_SESSION_DESKTOP=margo

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --who=Margo --why=lock-before-suspend-on-lid-close /usr/bin/sleep infinity
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=margo-session.target
