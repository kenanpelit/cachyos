[Unit]
Description=Automatic power-profile manager for margo (mpower)
After=graphical-session.target
PartOf=margo-session.target graphical-session.target
# Bound to the margo session target (like the other margo-* units), so it only
# ever runs under margo and never double-manages powerprofilesctl. The
# ConditionEnvironment is belt-and-suspenders, matching the sibling units.
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_SESSION_DESKTOP=margo

[Service]
Type=simple
ExecStart=/usr/bin/mpower run
Restart=on-failure
RestartSec=3
# Cheap single-threaded poller — stay nice so it never competes with the
# workload it measures.
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=margo-session.target
