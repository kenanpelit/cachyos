[Unit]
Description=Elephant - Backend provider for Walker
# Yalnızca margo başlattığında çalışsın.
After=margo-session.target
PartOf=margo-session.target
StartLimitBurst=10
StartLimitIntervalSec=120

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=elephant
Restart=always
RestartSec=3
MemoryMax=500M
CPUQuota=50%
TimeoutStopSec=10

[Install]
WantedBy=margo-session.target
