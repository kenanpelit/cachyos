[Unit]
Description=Walker - Application launcher
Documentation=https://github.com/abenz1267/walker
# Yalnızca margo başlattığında çalışsın — niri/hyprland/diğer DE'ler
# tetiklemesin. (margo-session.target uwsm tarafından oluşturulur.)
PartOf=margo-session.target
After=margo-session.target elephant.service
Requires=elephant.service

[Service]
Type=simple
CPUWeight=20
IOWeight=20
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStartPre=/usr/bin/sleep 2
ExecStart=walker --gapplication-service
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=10

[Install]
WantedBy=margo-session.target
