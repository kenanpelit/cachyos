[Unit]
Description=Niri Bluetooth auto-connect
# Sadece Niri oturumundaysak çalış
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
Wants=pipewire.service wireplumber.service
After=pipewire.service wireplumber.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30s
ExecStart=/usr/bin/bash -lc '%h/.local/bin/bluetooth_toggle --connect'
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
