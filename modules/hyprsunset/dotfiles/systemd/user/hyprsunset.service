[Unit]
Description=Hyprsunset blue-light and gamma filter
After=hypr-bootstrap.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.config/hypr/hyprsunset.conf

[Service]
Type=simple
ExecStart=/usr/bin/hyprsunset
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
