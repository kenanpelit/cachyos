[Unit]
Description=CopyQ clipboard manager daemon
After=graphical-session.target niri-session-env.service hypr-session-env.service mango-session-env.service dbus.service
PartOf=graphical-session.target niri-session.target hyprland-session.target mangowm-session.target
Requisite=graphical-session.target
# Bound to the three desktop session targets that need it. margo ships its
# own clipboard history (mshell-clipboard), so CopyQ is redundant there and
# is intentionally NOT wired to margo-session.target. We do not rely on
# graphical-session.target as a catch-all (that would pull CopyQ into every
# session, margo included).

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland;xcb
ExecStart=/usr/bin/copyq
ExecStop=/usr/bin/copyq exit
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
WantedBy=hyprland-session.target
WantedBy=mangowm-session.target
