[Unit]
Description=CopyQ clipboard manager daemon
After=graphical-session.target niri-session-env.service hypr-session-env.service dbus.service
PartOf=graphical-session.target niri-session.target hyprland-session.target
Requisite=graphical-session.target
# margo ships its own clipboard history (mshell-clipboard), so CopyQ is
# redundant there. Skip the unit when the session is margo — it still
# starts under niri / Hyprland / any other desktop. (graphical-session
# .target would otherwise pull it in for every session, margo included.)
ConditionEnvironment=!XDG_CURRENT_DESKTOP=margo

[Service]
Type=simple
Environment=QT_QPA_PLATFORM=wayland;xcb
ExecStart=/usr/bin/copyq
ExecStop=/usr/bin/copyq exit
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
WantedBy=niri-session.target
WantedBy=hyprland-session.target
