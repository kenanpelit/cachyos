#!/usr/bin/env bash
# Hyprland session wrapper for UWSM-first startup.
set -euo pipefail

helper_path="${HOME}/.local/bin/hypr-session-common"
[[ -r "${helper_path}.sh" ]] && helper_path="${helper_path}.sh"

if [[ -r "${helper_path}" ]]; then
  # shellcheck source=/dev/null
  source "${helper_path}"
  hypr_ensure_runtime_dir
  hypr_clear_foreign_session_env
  hypr_load_session_env
  hypr_normalize_session_paths
fi

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=Hyprland
export DESKTOP_SESSION=hyprland-uwsm
export GDMSESSION=hyprland-uwsm
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"
export SYSTEMD_OFFLINE="${SYSTEMD_OFFLINE:-0}"

if declare -F session_common_unset_manager_env >/dev/null 2>&1; then
  session_common_unset_manager_env \
    GDK_BACKEND \
    WAYLAND_DISPLAY \
    DISPLAY \
    NIRI_SOCKET \
    HYPRLAND_INSTANCE_SIGNATURE \
    HYPRLAND_SOCKET \
    HYPRLAND_CMD \
    HYPRCURSOR_THEME \
    HYPRCURSOR_SIZE \
    NOCTALIA_STARTUP_HINT \
    UWSM_WAIT_VARNAMES \
    UWSM_FINALIZE_VARNAMES \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION \
    GDMSESSION
  session_common_set_manager_env \
    "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP}" \
    "XDG_SESSION_TYPE=${XDG_SESSION_TYPE}" \
    "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP}" \
    "DESKTOP_SESSION=${DESKTOP_SESSION}" \
    "GDMSESSION=${GDMSESSION}" \
    "GTK_USE_PORTAL=${GTK_USE_PORTAL}" \
    "SYSTEMD_OFFLINE=${SYSTEMD_OFFLINE}"
fi

if command -v uwsm >/dev/null 2>&1; then
  if command -v start-hyprland >/dev/null 2>&1; then
    exec uwsm start -D Hyprland -e -- start-hyprland
  fi
  exec uwsm start -D Hyprland -e -- Hyprland
fi

if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland
fi

exec Hyprland
