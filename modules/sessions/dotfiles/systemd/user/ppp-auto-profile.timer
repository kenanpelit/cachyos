[Unit]
Description=Periodic power profile chooser
PartOf=graphical-session.target
# Mirror the service: only on non-margo sessions (Hyprland/niri/mango/…).
# Under margo the timer's condition fails, so it never fires.
ConditionEnvironment=!XDG_CURRENT_DESKTOP=margo

[Timer]
# İlk çalışma: oturum açıldıktan kısa süre sonra
OnActiveSec=5s
# Sonraki çalışmalar: hızlı tepki için 5 saniyede bir
OnUnitActiveSec=5s
AccuracySec=1s
Unit=ppp-auto-profile.service

[Install]
WantedBy=graphical-session.target
