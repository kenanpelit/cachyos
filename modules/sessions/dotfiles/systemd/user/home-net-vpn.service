[Unit]
Description=Ensure home Wi-Fi and Mullvad state after login
After=graphical-session.target dbus.service
PartOf=graphical-session.target
Requisite=graphical-session.target
ConditionPathExists=%h/.local/bin/home-net-vpn

[Service]
Type=oneshot
TimeoutStartSec=60
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/home-net-vpn
StandardOutput=journal
StandardError=journal
