#!/usr/bin/env bash
# MangoWM session wrapper for UWSM-first startup.
set -euo pipefail

helper_path="${HOME}/.local/bin/mango-session-common"
[[ -r "${helper_path}.sh" ]] && helper_path="${helper_path}.sh"

if [[ ! -r "${helper_path}" ]]; then
  printf '[mango-uwsm-session] ERROR: required helper missing: %s\n' "${helper_path}" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "${helper_path}"
mango_ensure_runtime_dir
mango_clear_foreign_session_env
mango_load_session_env
mango_normalize_session_paths
session_common_backfill_visual_env

export XDG_CURRENT_DESKTOP=mango
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mango
export DESKTOP_SESSION=mango-uwsm
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"
export SYSTEMD_OFFLINE="${SYSTEMD_OFFLINE:-0}"

if declare -F session_common_unset_manager_env >/dev/null 2>&1; then
  session_common_unset_manager_env \
    GDK_BACKEND \
    WAYLAND_DISPLAY \
    DISPLAY \
    NIRI_SOCKET \
    HYPRLAND_INSTANCE_SIGNATURE \
    HYPRLAND_SOCKET \
    HYPRLAND_CMD \
    HYPRCURSOR_THEME \
    HYPRCURSOR_SIZE \
    NOCTALIA_STARTUP_HINT \
    UWSM_WAIT_VARNAMES \
    UWSM_FINALIZE_VARNAMES \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION
  session_common_set_manager_env \
    "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP}" \
    "XDG_SESSION_TYPE=${XDG_SESSION_TYPE}" \
    "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP}" \
    "DESKTOP_SESSION=${DESKTOP_SESSION}" \
    "PATH=${PATH}" \
    "XDG_DATA_DIRS=${XDG_DATA_DIRS:-}" \
    "XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}" \
    "GTK_THEME=${GTK_THEME:-}" \
    "XDG_ICON_THEME=${XDG_ICON_THEME:-}" \
    "QT_ICON_THEME=${QT_ICON_THEME:-}" \
    "QT_QPA_PLATFORMTHEME=${QT_QPA_PLATFORMTHEME:-}" \
    "QT_QPA_PLATFORMTHEME_QT6=${QT_QPA_PLATFORMTHEME_QT6:-}" \
    "QT_STYLE_OVERRIDE=${QT_STYLE_OVERRIDE:-}" \
    "XCURSOR_THEME=${XCURSOR_THEME:-capitaine-cursors}" \
    "XCURSOR_SIZE=${XCURSOR_SIZE:-24}" \
    "GTK_USE_PORTAL=${GTK_USE_PORTAL}" \
    "SYSTEMD_OFFLINE=${SYSTEMD_OFFLINE}"
fi

config_file="${HOME}/.config/mango/config.conf"

if command -v uwsm >/dev/null 2>&1; then
  exec uwsm start -D mango -e -- mango -c "${config_file}"
fi

exec mango -c "${config_file}"
