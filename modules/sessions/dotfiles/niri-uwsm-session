#!/usr/bin/env bash
# Niri session wrapper for UWSM-first startup.
set -euo pipefail

helper_path="${HOME}/.local/bin/niri-session-common"
[[ -r "${helper_path}.sh" ]] && helper_path="${helper_path}.sh"

if [[ -r "${helper_path}" ]]; then
  # shellcheck source=/dev/null
  source "${helper_path}"
  niri_ensure_runtime_dir
  niri_clear_foreign_session_env
  niri_load_session_env
  niri_normalize_session_paths
fi

export XDG_CURRENT_DESKTOP=niri
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=niri
export DESKTOP_SESSION=niri-uwsm
export GDMSESSION=niri-uwsm
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"
export NOCTALIA_STARTUP_HINT="${NOCTALIA_STARTUP_HINT:-1}"
export SYSTEMD_OFFLINE="${SYSTEMD_OFFLINE:-0}"

if declare -F session_common_unset_manager_env >/dev/null 2>&1; then
  session_common_unset_manager_env \
    WAYLAND_DISPLAY \
    DISPLAY \
    NIRI_SOCKET \
    HYPRLAND_INSTANCE_SIGNATURE \
    HYPRLAND_SOCKET \
    HYPRLAND_CMD \
    HYPRCURSOR_THEME \
    HYPRCURSOR_SIZE \
    UWSM_WAIT_VARNAMES \
    UWSM_FINALIZE_VARNAMES \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION \
    GDMSESSION
  session_common_set_manager_env \
    "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP}" \
    "XDG_SESSION_TYPE=${XDG_SESSION_TYPE}" \
    "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP}" \
    "DESKTOP_SESSION=${DESKTOP_SESSION}" \
    "GDMSESSION=${GDMSESSION}" \
    "GTK_USE_PORTAL=${GTK_USE_PORTAL}" \
    "NOCTALIA_STARTUP_HINT=${NOCTALIA_STARTUP_HINT}" \
    "SYSTEMD_OFFLINE=${SYSTEMD_OFFLINE}"
fi

if command -v uwsm >/dev/null 2>&1; then
  if command -v niri-session >/dev/null 2>&1; then
    exec uwsm start -D niri -e -- niri-session
  fi
  exec uwsm start -D niri -e -- niri
fi

if command -v niri-session >/dev/null 2>&1; then
  exec niri-session
fi

exec niri --session
