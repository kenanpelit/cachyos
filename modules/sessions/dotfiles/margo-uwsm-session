#!/usr/bin/env bash
# Margo session wrapper for UWSM-first startup.
set -euo pipefail

helper_path="${HOME}/.local/bin/margo-session-common"
[[ -r "${helper_path}.sh" ]] && helper_path="${helper_path}.sh"

if [[ ! -r "${helper_path}" ]]; then
  printf '[margo-uwsm-session] ERROR: required helper missing: %s\n' "${helper_path}" >&2
  exit 1
fi

# shellcheck source=/dev/null
source "${helper_path}"
margo_ensure_runtime_dir
margo_clear_foreign_session_env
margo_load_session_env
margo_normalize_session_paths
export XDG_CURRENT_DESKTOP=margo:mango
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=margo
export DESKTOP_SESSION=margo-uwsm
export GTK_USE_PORTAL="${GTK_USE_PORTAL:-1}"
export SYSTEMD_OFFLINE="${SYSTEMD_OFFLINE:-0}"

# Visual / theme defaults — applied unless already set by the user's
# environment.d/* or login profile. Kora is the cachy stack's icon
# theme of record; matching cursor + Qt platform theme are picked here
# so apps launched from systemd user units see consistent values.
export XDG_ICON_THEME="${XDG_ICON_THEME:-kora}"
export ICON_THEME="${ICON_THEME:-${XDG_ICON_THEME}}"
export QT_ICON_THEME="${QT_ICON_THEME:-${XDG_ICON_THEME}}"
export XCURSOR_THEME="${XCURSOR_THEME:-capitaine-cursors}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export GTK_THEME="${GTK_THEME:-Adwaita-dark}"
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-qt6ct}"
export QT_QPA_PLATFORMTHEME_QT6="${QT_QPA_PLATFORMTHEME_QT6:-qt6ct}"

session_common_backfill_visual_env

if declare -F session_common_unset_manager_env >/dev/null 2>&1; then
  session_common_unset_manager_env \
    GDK_BACKEND \
    WAYLAND_DISPLAY \
    DISPLAY \
    NIRI_SOCKET \
    HYPRLAND_INSTANCE_SIGNATURE \
    HYPRLAND_SOCKET \
    HYPRLAND_CMD \
    HYPRCURSOR_THEME \
    HYPRCURSOR_SIZE \
    NOCTALIA_STARTUP_HINT \
    UWSM_WAIT_VARNAMES \
    UWSM_FINALIZE_VARNAMES \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_SESSION_DESKTOP \
    DESKTOP_SESSION
  # Defaults filled in above (kora icon theme, capitaine cursors, etc.)
  # so the systemd manager environment ends up matching what the
  # session itself exports — no more `echo $XDG_ICON_THEME` returning
  # empty under noctalia / qs / GTK apps launched through user units.
  session_common_set_manager_env \
    "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP}" \
    "XDG_SESSION_TYPE=${XDG_SESSION_TYPE}" \
    "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP}" \
    "DESKTOP_SESSION=${DESKTOP_SESSION}" \
    "PATH=${PATH}" \
    "XDG_DATA_DIRS=${XDG_DATA_DIRS:-}" \
    "XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-/etc/xdg}" \
    "GTK_THEME=${GTK_THEME}" \
    "XDG_ICON_THEME=${XDG_ICON_THEME}" \
    "ICON_THEME=${ICON_THEME}" \
    "QT_ICON_THEME=${QT_ICON_THEME}" \
    "QT_QPA_PLATFORMTHEME=${QT_QPA_PLATFORMTHEME}" \
    "QT_QPA_PLATFORMTHEME_QT6=${QT_QPA_PLATFORMTHEME_QT6}" \
    "QT_STYLE_OVERRIDE=${QT_STYLE_OVERRIDE:-}" \
    "XCURSOR_THEME=${XCURSOR_THEME}" \
    "XCURSOR_SIZE=${XCURSOR_SIZE}" \
    "GTK_USE_PORTAL=${GTK_USE_PORTAL}" \
    "SYSTEMD_OFFLINE=${SYSTEMD_OFFLINE}"
fi

session_cmd="margo-session"

if command -v uwsm >/dev/null 2>&1; then
  if ! command -v "${session_cmd}" >/dev/null 2>&1; then
    session_cmd="margo"
  fi

  if [[ "${session_cmd}" == "margo-session" ]]; then
    exec uwsm start -D margo:mango -e -- "${session_cmd}"
  fi

  exec uwsm start -D margo:mango -e -- margo -c "${HOME}/.config/margo/config.conf"
fi

if command -v "${session_cmd}" >/dev/null 2>&1; then
  exec "${session_cmd}"
fi

exec margo -c "${HOME}/.config/margo/config.conf"
