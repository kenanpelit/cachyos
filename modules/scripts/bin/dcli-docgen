#!/usr/bin/env bash
# ==============================================================================
# Script: dcli-docgen
# Description: Automatically generates markdown documentation from script headers.
# Usage: dcli-docgen
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SCRIPTS_DIR="$REPO_ROOT/modules/scripts/bin"
DOCS_DIR="$REPO_ROOT/docs"
DOCS_FILE="$DOCS_DIR/SCRIPTS.md"

mkdir -p "$DOCS_DIR"

echo "# 🛠️ CachyOS / DCLI Custom Scripts" > "$DOCS_FILE"
echo "This file is automatically generated. **Do not edit manually.**" >> "$DOCS_FILE"
echo "" >> "$DOCS_FILE"
echo "These scripts are located in \`modules/scripts/bin\` and are symlinked to \`~/.local/bin\` during a sync." >> "$DOCS_FILE"
echo "" >> "$DOCS_FILE"

# Iterate over all executable scripts
for script in "$SCRIPTS_DIR"/*; do
    if [[ -f "$script" && -x "$script" ]]; then
        basename="$(basename "$script")"
        cmd_name="${basename%.sh}"
        
        # Extract fields from the standardized header (more flexible regex)
        desc="$(grep -iE "^#+[[:space:]]*Description:" "$script" | head -n 1 | sed -E 's/^#+[[:space:]]*Description:[[:space:]]*//I' || true)"
        usage="$(grep -iE "^#+[[:space:]]*Usage:" "$script" | head -n 1 | sed -E 's/^#+[[:space:]]*Usage:[[:space:]]*//I' || true)"
        
        # Fallback for non-standardized scripts: try to find any meaningful comment at the top
        if [[ -z "$desc" ]]; then
            # Get the first line after shebang that isn't just decoration or common metadata
            desc="$(head -n 15 "$script" | grep -v "^#!" | grep "^#" | grep -viE "script:|usage:|author|date|version|license|==|--" | head -n 1 | sed -E 's/^#+[[:space:]]*//' || true)"
        fi
        
        [[ -z "$desc" ]] && desc="No description provided."
        [[ -z "$usage" ]] && usage="$cmd_name"

        echo "### 📂 \`$cmd_name\`" >> "$DOCS_FILE"
        echo "**Description:** $desc" >> "$DOCS_FILE"
        echo "" >> "$DOCS_FILE"
        echo "**Usage:** \`$usage\`" >> "$DOCS_FILE"
        echo "" >> "$DOCS_FILE"
        echo "---" >> "$DOCS_FILE"
        echo "" >> "$DOCS_FILE"
    fi
done

echo "✅ Documentation successfully generated at docs/SCRIPTS.md"
