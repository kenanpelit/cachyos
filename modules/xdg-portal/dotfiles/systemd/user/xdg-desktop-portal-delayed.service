[Unit]
Description=Delayed XDG Desktop Portal Orchestration
After=graphical-session.target hyprland-session.target niri-session.target
PartOf=graphical-session.target hyprland-session.target niri-session.target
Requisite=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=oneshot
# Use the installed user-local helper directly; systemd user PATH is not reliable.
ExecStart=%h/.local/bin/delayed-portals 0
StandardOutput=journal
StandardError=journal
