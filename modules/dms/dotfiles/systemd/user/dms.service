[Unit]
Description=DankMaterialShell
After=hyprland-session.target niri-bootstrap.service niri-daemons.target
PartOf=niri-daemons.target hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecCondition=/usr/bin/bash -lc 'backend="$("%h/.local/bin/osc-shell" backend 2>/dev/null || osc-shell backend 2>/dev/null || echo noctalia)"; [[ "$backend" == "dms" ]]'
Environment=DMS_SCREENSHOT_EDITOR=swappy
Environment=TERMINAL=kitty
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=QT_QPA_PLATFORMTHEME=gtk3
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"; if [[ "${XDG_CURRENT_DESKTOP:-}" == "niri" ]] && [[ -n "${NIRI_SOCKET:-}" ]] && [[ -z "${WAYLAND_DISPLAY:-}" ]]; then base="$(basename "$NIRI_SOCKET")"; rest="${base#niri.}"; display="${rest%%.*}"; [[ "$display" == wayland-* ]] && export WAYLAND_DISPLAY="$display"; fi; if [[ "${XDG_CURRENT_DESKTOP:-}" == "niri" ]] && [[ -z "${NIRI_SOCKET:-}" ]]; then for _ in {1..200}; do for sock in "$XDG_RUNTIME_DIR"/niri.wayland-*.*.sock "$XDG_RUNTIME_DIR"/niri.*.sock; do [[ -S "$sock" ]] || continue; export NIRI_SOCKET="$sock"; base="$(basename "$sock")"; rest="${base#niri.}"; display="${rest%%.*}"; [[ "$display" == wayland-* ]] && export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$display}"; break 2; done; sleep 0.05; done; fi; if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then for _ in {1..200}; do for sock in "$XDG_RUNTIME_DIR"/wayland-*; do [[ -S "$sock" ]] || continue; export WAYLAND_DISPLAY="$(basename "$sock")"; break 2; done; sleep 0.05; done; fi; exec dms run --session'
KillSignal=SIGINT
Restart=always
RestartSec=3
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

PassEnvironment=WAYLAND_DISPLAY
PassEnvironment=NIRI_SOCKET
PassEnvironment=HYPRLAND_INSTANCE_SIGNATURE
PassEnvironment=HYPRLAND_SOCKET
PassEnvironment=SWAYSOCK
PassEnvironment=XDG_CURRENT_DESKTOP
PassEnvironment=XDG_SESSION_TYPE
PassEnvironment=XDG_SESSION_DESKTOP

[Install]
WantedBy=niri-daemons.target hyprland-session.target
