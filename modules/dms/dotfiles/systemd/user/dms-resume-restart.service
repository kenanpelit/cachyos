[Unit]
Description=DMS: restart after resume
After=hyprland-session.target niri-session.target dms.service
PartOf=niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecCondition=/usr/bin/bash -lc 'backend="$("%h/.local/bin/osc-shell" backend niri 2>/dev/null || osc-shell backend niri 2>/dev/null || echo noctalia)"; [[ "$backend" == "dms" ]]'
ExecStart=%h/.local/bin/dms-resume-restart
Restart=always
RestartSec=2

[Install]
WantedBy=niri-session.target
