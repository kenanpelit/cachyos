#!/usr/bin/env bash
set -euo pipefail

# Fail-safe, run at boot and then every 30s for the rest of the session
# (osc-mullvad-boot-ensure.timer): login-net's own Mullvad/Blocky reconcile
# only runs once at login, so nothing else catches a tunnel that drops and
# gets stuck in Mullvad's Blocked/Error killswitch state mid-session.
# - Mullvad healthy -> keep Blocky off.
# - Mullvad disconnected/unhealthy/revoked -> enable Blocky fallback.

grace_sec="${OSC_MULLVAD_BOOT_GRACE_SEC:-35}"
poll_sec="${OSC_MULLVAD_BOOT_POLL_SEC:-2}"
require_internet="${OSC_MULLVAD_BOOT_REQUIRE_INTERNET:-1}"
check_url="${OSC_MULLVAD_BOOT_CHECK_URL:-https://am.i.mullvad.net/connected}"
check_expect="${OSC_MULLVAD_BOOT_CHECK_EXPECT:-You are connected}"
connect_timeout="${OSC_MULLVAD_BOOT_CONNECT_TIMEOUT:-2}"
max_time="${OSC_MULLVAD_BOOT_MAX_TIME:-4}"

[[ "$grace_sec" =~ ^[0-9]+$ ]] || grace_sec=35
[[ "$poll_sec" =~ ^[0-9]+$ ]] || poll_sec=2
(( poll_sec > 0 )) || poll_sec=2

has_blocky=0
if systemctl list-unit-files blocky.service >/dev/null 2>&1; then
	has_blocky=1
fi

blocky_set_resolver_local() {
	rm -f /etc/resolv.conf
	printf "nameserver 127.0.0.1\nnameserver ::1\n" >/etc/resolv.conf
}

blocky_start() {
	[[ "$has_blocky" -eq 1 ]] || return 0
	systemctl start blocky.service >/dev/null 2>&1 || true
	blocky_set_resolver_local || true
}

blocky_stop() {
	[[ "$has_blocky" -eq 1 ]] || return 0
	systemctl stop blocky.service >/dev/null 2>&1 || true
}

mullvad_soft_disable() {
	if ! command -v mullvad >/dev/null 2>&1; then
		return 0
	fi
	mullvad disconnect >/dev/null 2>&1 || true
	mullvad auto-connect set off >/dev/null 2>&1 || true
	mullvad lockdown-mode set off >/dev/null 2>&1 || true
}

mullvad_blocked_state() {
	local status_text=""
	status_text="$(mullvad status 2>/dev/null || true)"
	[[ -n "$status_text" ]] || return 1
	echo "$status_text" | grep -qi "Blocked:" && return 0
	echo "$status_text" | grep -qi "device has been revoked" && return 0
	return 1
}

vpn_connected() {
	mullvad status 2>/dev/null | grep -q "Connected"
}

vpn_healthy() {
	vpn_connected || return 1

	if [[ "$require_internet" != "1" ]]; then
		return 0
	fi

	if ! command -v curl >/dev/null 2>&1; then
		return 0
	fi

	curl -fsS --connect-timeout "$connect_timeout" --max-time "$max_time" "$check_url" 2>/dev/null | grep -qi "$check_expect"
}

if ! command -v mullvad >/dev/null 2>&1; then
	echo "mullvad CLI not found; enabling Blocky fallback."
	blocky_start
	exit 0
fi

# `account get` round-trips the daemon's own API call, not just local state.
# Observed 2026-10-15: a WireGuard keepalive-ping failure triggered a
# reconnect; during the firewall-policy transition every API access method
# briefly returned "Connection refused", making a single `account get` fail
# even though the account was never actually logged out. Retry a few times
# before concluding it's a real logout — this check now ran periodically
# (not just at boot), so a multi-second API hiccup is far more likely to be
# sampled than it was as a one-shot boot check.
account_ok() {
	local tries=3 i
	for ((i = 0; i < tries; i++)); do
		mullvad account get >/dev/null 2>&1 && return 0
		(( i < tries - 1 )) && sleep "$poll_sec"
	done
	return 1
}

if ! account_ok; then
	echo "Mullvad account not logged in; enabling Blocky fallback."
	mullvad_soft_disable
	blocky_start
	exit 0
fi

if mullvad_blocked_state; then
	echo "Mullvad blocked/revoked state detected; enabling Blocky fallback."
	mullvad_soft_disable
	blocky_start
	exit 0
fi

elapsed=0
while (( elapsed <= grace_sec )); do
	if vpn_healthy; then
		blocky_stop
		exit 0
	fi
	sleep "$poll_sec"
	elapsed=$((elapsed + poll_sec))
done

echo "Mullvad not healthy after grace window; enabling Blocky fallback."
mullvad_soft_disable
blocky_start
