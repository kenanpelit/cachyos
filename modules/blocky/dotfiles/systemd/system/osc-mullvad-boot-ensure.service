[Unit]
Description=Ensure Mullvad/Blocky DNS fail-safe state on boot
Wants=network-online.target mullvad-daemon.service
After=network-online.target NetworkManager.service mullvad-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/osc-mullvad-boot-ensure
Environment=OSC_MULLVAD_BOOT_GRACE_SEC=20
Environment=OSC_MULLVAD_BOOT_POLL_SEC=2
Environment=OSC_MULLVAD_BOOT_REQUIRE_INTERNET=1
Environment=OSC_MULLVAD_BOOT_CHECK_URL=https://am.i.mullvad.net/connected
Environment=OSC_MULLVAD_BOOT_CHECK_EXPECT=You are connected
Environment=OSC_MULLVAD_BOOT_CONNECT_TIMEOUT=2
Environment=OSC_MULLVAD_BOOT_MAX_TIME=4

[Install]
WantedBy=multi-user.target
