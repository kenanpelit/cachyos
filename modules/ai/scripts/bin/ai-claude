#!/usr/bin/env bash
set -euo pipefail

# HOME bazı izole ortamlarda boş olabilir
if [ -z "${HOME:-}" ]; then
  export HOME=/tmp
fi

export PATH="$HOME/.local/bin:$PATH"

CLAUDE_BIN="$HOME/.local/bin/claude"

if [ ! -x "$CLAUDE_BIN" ]; then
  echo "Hata: Claude Code native binary bulunamadı."
  echo "Beklenen konum: $CLAUDE_BIN"
  echo
  echo "Kurmak için:"
  echo "curl -fsSL https://claude.ai/install.sh | bash"
  exit 1
fi

exec "$CLAUDE_BIN" "$@"
