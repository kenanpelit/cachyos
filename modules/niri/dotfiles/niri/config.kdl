// ========================================================================
// NIRI COMPOSITOR CONFIGURATION
// ========================================================================
// Optimized for CachyOS / Noctalia.
// Focus: Clean aesthetics, predictable tiling, and performance.
// ========================================================================
include "conf/00-base.kdl"

// Declarative monitor layout is owned directly by the Niri module.
include "outputs.kdl"
// Workspace placement stays runtime-managed so workspace-mode toggles still work.
include optional=true "runtime/workspaces-auto.kdl"

include "conf/10-layout.kdl"
include "generated/theme.kdl"
include optional=true "runtime/zen.kdl"
include "conf/20-binds-core.kdl"
include "generated/workspace-shortcuts.kdl"
include "conf/30-window-rules-base.kdl"
include "generated/workspace-rules.kdl"
include "conf/31-window-rules-privacy.kdl"
include "conf/40-layer-rules.kdl"
include "conf/41-background-effects.kdl"
include "conf/50-animations.kdl"
include "conf/60-gestures.kdl"

// Machine-local overrides are intentionally outside the repo.
// `ensure-runtime-files.sh` creates this file to avoid optional-include log noise.
include optional=true "runtime/debug.kdl"
include optional=true "~/.config/niri/local.kdl"
