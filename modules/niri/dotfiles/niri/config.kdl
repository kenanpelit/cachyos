// ========================================================================
// NIRI COMPOSITOR CONFIGURATION
// ========================================================================
// Optimized for CachyOS / Noctalia.
// Focus: Clean aesthetics, predictable tiling, and performance.
// ========================================================================

cursor {
  // Apply the system-wide cursor theme directly in the compositor, not just via env.
  xcursor-theme "capitaine-cursors"
  xcursor-size 24
  // Hide cursor during keyboard input for better focus.
  hide-when-typing
  // Auto-hide after 1 second of inactivity to keep workspace clean.
  hide-after-inactive-ms 1000
}

// Request applications to skip Client Side Decorations (CSD) where possible.
prefer-no-csd

hotkey-overlay {
  // Skip showing the help overlay at startup for a cleaner entry.
  skip-at-startup
  // Hide keys that aren't currently bound to avoid clutter.
  hide-not-bound
}

overview {
  // Zoom level for the workspace overview.
  zoom 0.25
  backdrop-color "#313244"
  workspace-shadow {
    softness 40
    spread 12
    offset x=0 y=12
    color "#00000050"
  }
}

// Integrate wallpaper surfaces into the overview backdrop for visual depth.
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

// ------------------------------------------------------------------------
// INPUT CONFIGURATION
// ------------------------------------------------------------------------
input {
  // Cycle workspaces automatically when reaching the boundaries.
  workspace-auto-back-and-forth
  // Enable focus-follows-mouse with a high threshold for intentionality.
  focus-follows-mouse max-scroll-amount="90%"
  // Warp mouse to focus for deterministic navigation.
  warp-mouse-to-focus mode="center-xy"

  keyboard {
    xkb {
      layout "tr"
      variant "f"
      options "ctrl:nocaps"
    }
    // Responsive repeat rates for fast terminal/Vim navigation.
    repeat-delay 250
    repeat-rate 35
  }

  touchpad {
    tap
    dwt    // Disable-while-typing.
    dwtp   // Disable-while-trackpointing.
    drag-lock
    tap-button-map "left-right-middle"
    middle-emulation
    click-method "clickfinger"
    accel-profile "adaptive"
    accel-speed 1.0
    scroll-method "two-finger"
    scroll-factor 1.0
  }

  mouse {
    accel-profile "adaptive"
    accel-speed 0.0
    scroll-factor 1.0
  }

  trackpoint {
    accel-profile "adaptive"
    accel-speed 0.0
    middle-emulation
    scroll-method "on-button-down"
    scroll-button 273
    scroll-button-lock
  }
}

// Performance tweak: deactivate unfocused Electron/Chromium windows.
debug {
  deactivate-unfocused-windows
}

// ------------------------------------------------------------------------
// SWITCH EVENTS
// ------------------------------------------------------------------------
switch-events {
  // Integration with logind for laptop lid actions (locking, etc).
  lid-close {
    spawn "niri-osc" "set" "lock" "--logind"
  }
}

// ------------------------------------------------------------------------
// HARDWARE & MONITOR LAYOUT
// ------------------------------------------------------------------------
// Declarative monitor layout is owned directly by the Niri module.
include "outputs.kdl"
// Workspace placement stays runtime-managed so workspace-mode toggles still work.
include optional=true "runtime/workspaces-auto.kdl"

layout {
  // Inner and outer gaps between windows for a consistent look.
  gaps 6
  // Strategy for centering columns when they overflow the monitor width.
  center-focused-column "on-overflow"
  always-center-single-column
  background-color "#00000000"

  focus-ring {
    on
    width 3
    active-gradient from="#bd8ff5" to="#cba6f7" angle=45 relative-to="workspace-view" in="oklch shorter hue"
    inactive-color "#313244"
    urgent-color "#f38ba8"
  }

  border {
    // Border is kept off to prioritize the focus-ring aesthetic.
    off
  }

  shadow {
    // Subtle shadow for all tiled windows.
    color "#11111b70"
  }

  tab-indicator {
    // Configuration for tabbed columns (grouping windows).
    hide-when-single-tab
    place-within-column
    width 4
    gap 6
    length total-proportion=0.9
    position "top"
    gaps-between-tabs 4
    corner-radius 8
    active-color "#cba6f7"
    inactive-color "#6b02e9"
    urgent-color "#f38ba8"
  }

  insert-hint {
    // Visual hint when moving or inserting windows.
    color "#cba6f780"
  }

  // Sizing presets for column widths toggled via Mod+R.
  preset-column-widths {
    proportion 0.382
    proportion 0.500
    proportion 0.618
    proportion 0.786
    proportion 1.000
  }

  // Sizing presets for window heights toggled via Mod+Ctrl+R.
  preset-window-heights {
    proportion 0.382
    proportion 0.500
    proportion 0.618
    proportion 0.786
    proportion 1.000
 }

  // Windows open at 90% width by default to maintain visibility of adjacent columns.
  default-column-width {
   //proportion 0.618
   proportion 0.786
 }
}

recent-windows {
  // Keep the native switcher available on Mod+Tab without replacing shell Alt+Tab.
  debounce-ms 450
  open-delay-ms 100

  highlight {
    active-color "#cba6f7"
    urgent-color "#f38ba8"
    padding 18
    corner-radius 14
  }

  previews {
    max-height 560
    max-scale 0.60
  }

  binds {
    Mod+Tab { next-window scope="output"; }
    Mod+Shift+Tab { previous-window scope="output"; }
    Mod+grave { next-window filter="app-id" scope="workspace"; }
    Mod+Shift+grave { previous-window filter="app-id" scope="workspace"; }
  }
}

include optional=true "runtime/zen.kdl"

// ========================================================================
// KEYBINDINGS
// ========================================================================
binds {
  // ----------------------------------------------------------------------
  // Window Focus (Vim & Arrows)
  // ----------------------------------------------------------------------
  Mod+Left  hotkey-overlay-title="Focus Left"  { focus-column-left; }
  Mod+Right hotkey-overlay-title="Focus Right" { focus-column-right; }
  Mod+Up    hotkey-overlay-title="Focus Up"    { focus-workspace-up; }
  Mod+Down  hotkey-overlay-title="Focus Down"  { focus-workspace-down; }

  Mod+H hotkey-overlay-title="Focus Left"  { focus-column-left; }
  Mod+L hotkey-overlay-title="Focus Right" { focus-column-right; }
  Mod+K hotkey-overlay-title="Focus Up"    { focus-workspace-up; }
  Mod+J hotkey-overlay-title="Focus Down"  { focus-workspace-down; }

  // Navigation within tabbed columns.
  Mod+Ctrl+K hotkey-overlay-title="Focus Window Up"   { focus-window-up; }
  Mod+Ctrl+J hotkey-overlay-title="Focus Window Down" { focus-window-down; }

  // ----------------------------------------------------------------------
  // Window Movement (Shift + Vim/Arrows)
  // ----------------------------------------------------------------------
  Mod+Shift+Left  hotkey-overlay-title="Move Left"  { move-column-left; }
  Mod+Shift+Right hotkey-overlay-title="Move Right" { move-column-right; }
  Mod+Shift+Up    hotkey-overlay-title="Move Up"    { move-window-up; }
  Mod+Shift+Down  hotkey-overlay-title="Move Down"  { move-window-down; }

  Mod+Shift+H hotkey-overlay-title="Move Left"  { move-column-left; }
  Mod+Shift+L hotkey-overlay-title="Move Right" { move-column-right; }
  Mod+Shift+K hotkey-overlay-title="Move Up"    { move-window-up; }
  Mod+Shift+J hotkey-overlay-title="Move Down"  { move-window-down; }

  // ----------------------------------------------------------------------
  // Core Window Actions
  // ----------------------------------------------------------------------
  Mod+Q hotkey-overlay-title="Close Window" { close-window; }
  Alt+F4 hotkey-overlay-title="Close Window Alt+F4" { close-window; }
  Mod+F hotkey-overlay-title="Fullscreen"   { fullscreen-window; }
  Mod+M hotkey-overlay-title="Maximize Column" { maximize-column; }
  Mod+C hotkey-overlay-title="Center Column"   { center-column; }

  // Alternative close bind using mouse middle click.
  Mod+MouseMiddle { close-window; }

  // ----------------------------------------------------------------------
  // Sizing & Presets
  // ----------------------------------------------------------------------
  Mod+R       hotkey-overlay-title="Next Preset Width"  { switch-preset-column-width; }
  Mod+Ctrl+R  hotkey-overlay-title="Next Preset Height" { switch-preset-window-height; }
  Mod+Shift+R hotkey-overlay-title="Width 50%"          { set-column-width "50%"; }
  Mod+Alt+R   hotkey-overlay-title="Reset Window Height" { reset-window-height; }

  // Fixed geometry helpers via niri-osc (Half, HD, FHD).
  Mod+0 hotkey-overlay-title="Size: 960x540 (Half)" { spawn "niri-osc" "set" "size" "960" "540"; }
  Mod+Shift+0 hotkey-overlay-title="Size: 1280x720 (HD)" { spawn "niri-osc" "set" "size" "1280" "720"; }
  Mod+Ctrl+0 hotkey-overlay-title="Size: 1920x1080 (FHD)" { spawn "niri-osc" "set" "size" "1920" "1080"; }

  // Fine-grained incremental sizing.
  Mod+Minus       hotkey-overlay-title="Width -5%"  { set-column-width "-5%"; }
  Mod+Equal       hotkey-overlay-title="Width +5%"  { set-column-width "+5%"; }
  Mod+Shift+Minus hotkey-overlay-title="Height -5%" { set-window-height "-5%"; }
  Mod+Shift+Equal hotkey-overlay-title="Height +5%" { set-window-height "+5%"; }

  // ----------------------------------------------------------------------
  // Advanced Layout Modes
  // ----------------------------------------------------------------------
  Alt+G      repeat=false hotkey-overlay-title="Max to Edges" { maximize-window-to-edges; }
  Mod+Alt+O  repeat=false hotkey-overlay-title="Overview (Niri)" { toggle-overview; }
  Mod+Ctrl+W hotkey-overlay-title="Toggle Tabbed Mode" { toggle-column-tabbed-display; }

  // Floating window management.
  Mod+G hotkey-overlay-title="Toggle Float/Tile" { spawn "niri-osc" "set" "float"; }
  Mod+Ctrl+BackSpace hotkey-overlay-title="Focus Float/Tile" { switch-focus-between-floating-and-tiling; }

  // Layout expansion and alignment helpers.
  Mod+Ctrl+Shift+F hotkey-overlay-title="Expand Column (Fill)" { expand-column-to-available-width;}
  Mod+Ctrl+Shift+C hotkey-overlay-title="Center Visible Columns" { center-visible-columns;}

  // Focus modes (Zen: hide UI, Pin: Always on Top/PiP).
  Mod+Z repeat=false hotkey-overlay-title="Zen Mode" { spawn "niri-osc" "set" "zen"; }
  Mod+P repeat=false hotkey-overlay-title="Pin Window (PiP)" { spawn "niri-osc" "set" "pin"; }

  // Consume / Expel (Window Grouping into tabbed columns).
  Mod+Ctrl+Left  hotkey-overlay-title="Consume/Expel Left"  { consume-or-expel-window-left; }
  Mod+Ctrl+Right hotkey-overlay-title="Consume/Expel Right" { consume-or-expel-window-right; }
  Mod+Ctrl+H     hotkey-overlay-title="Consume/Expel Left"  { consume-or-expel-window-left; }
  Mod+Ctrl+L     hotkey-overlay-title="Consume/Expel Right" { consume-or-expel-window-right; }

  // Dynamic Opacity control.
  Mod+O hotkey-overlay-title="Toggle Opacity Rule" { toggle-window-rule-opacity; }
  Mod+Shift+WheelScrollDown hotkey-overlay-title="Opacity -10%" { spawn "niri" "msg" "action" "set-window-opacity" "-0.1"; }
  Mod+Shift+WheelScrollUp hotkey-overlay-title="Opacity +10%" { spawn "niri" "msg" "action" "set-window-opacity" "+0.1";}

  // ----------------------------------------------------------------------
  // Scratchpad Management (handled via niri-osc flow)
  // ----------------------------------------------------------------------
  Mod+BackSpace repeat=false hotkey-overlay-title="Scratch: Toggle" {
    spawn "niri-osc" "flow" "scratchpad-toggle"
  }
  Alt+BackSpace repeat=false hotkey-overlay-title="Scratch: Cycle" {
    spawn "niri-osc" "flow" "scratchpad-show"
  }
  Mod+Alt+BackSpace repeat=false hotkey-overlay-title="Scratch: Show All" {
    spawn "niri-osc" "flow" "scratchpad-show-all"
  }

  // Window Marking (tagging windows for quick focus).
  Mod+Alt+G repeat=false hotkey-overlay-title="Mark: Toggle Default" {
    spawn "niri-osc" "flow" "toggle-mark"
  }
  Mod+Alt+Shift+1 repeat=false hotkey-overlay-title="Mark: Set Term" {
    spawn "niri-osc" "flow" "toggle-mark" "term"
  }
  Mod+Alt+1 repeat=false hotkey-overlay-title="Mark: Go Term" {
    spawn "niri-osc" "flow" "focus-marked" "term"
  }

  // ----------------------------------------------------------------------
  // Noctalia Shell Integrations (Launcher & Centers)
  // ----------------------------------------------------------------------
  Mod+Space repeat=false hotkey-overlay-title="Launcher" {
    spawn "osc-shell" "ipc" "call" "launcher" "toggle"
  }
  Mod+Ctrl+D repeat=false hotkey-overlay-title="Settings" {
    spawn "osc-shell" "ipc" "call" "settings" "toggle"
  }
  Mod+D repeat=false hotkey-overlay-title="Control Center" {
    spawn "osc-shell" "ipc" "call" "control-center" "toggle"
  }
  Mod+Alt+D repeat=false hotkey-overlay-title="Dash Center" {
    spawn "osc-shell" "ipc" "call" "dash" "toggle" "overview"
  }
  Mod+N repeat=false hotkey-overlay-title="Notifications" {
    spawn "osc-shell" "ipc" "call" "notifications" "toggleHistory"
  }

  // Personal workflow tools and widgets.
  Mod+V repeat=false hotkey-overlay-title="CopyQ Toggle" {
    spawn "copyq" "toggle"
  }
  Mod+Shift+D repeat=false hotkey-overlay-title="Dash Overview" {
    spawn "osc-shell" "ipc" "call" "launcher" "windows"
  }
  Mod+Shift+P repeat=false hotkey-overlay-title="Process List" {
    spawn "osc-shell" "ipc" "call" "systemMonitor" "toggle"
  }
  Mod+Ctrl+N repeat=false hotkey-overlay-title="Notepad" {
    spawn "osc-shell" "ipc" "call" "plugin:notes" "togglePanel"
  }
  Mod+Comma repeat=false hotkey-overlay-title="Settings" {
    spawn "osc-shell" "ipc" "call" "settings" "toggle"
  }
  Mod+U repeat=false hotkey-overlay-title="Widget: SathiAi" {
    spawn "osc-shell" "ipc" "call" "plugin:assistant-panel" "toggle"
  }

  // Navigation via Alt+Tab integrated with the shell launcher.
  Alt+Tab hotkey-overlay-title="Switch Windows" {
    spawn "osc-shell" "ipc" "call" "launcher" "windows"
  }

  // UI Component Visibility toggles.
  Mod+B repeat=false hotkey-overlay-title="Toggle Bar" {
    spawn "osc-shell" "ipc" "call" "bar" "toggle"
  }
  Mod+Shift+B repeat=false hotkey-overlay-title="Toggle Dock" {
    spawn "osc-shell" "ipc" "call" "dock" "toggle"
  }
  Mod+Ctrl+B repeat=false hotkey-overlay-title="Auto-Hide Bar" {
    spawn "osc-shell" "ipc" "call" "bar" "toggleAutoHide"
  }

  // Session & Power management.
  Mod+Delete repeat=false hotkey-overlay-title="Power Menu" {
    spawn "osc-shell" "ipc" "call" "sessionMenu" "toggle"
  }
  Alt+L repeat=false hotkey-overlay-title="Lock Screen" {
    spawn "osc-shell" "ipc" "call" "lockScreen" "lock"
  }
  Ctrl+Alt+BackSpace repeat=false hotkey-overlay-title="Emergency Exit" {
    spawn "uwsm" "stop"
  }
  Mod+Shift+Delete repeat=false hotkey-overlay-title="Inhibit Idle" {
    spawn "osc-shell" "ipc" "call" "idleInhibitor" "toggle"
  }

  // Aesthetic & Wallpaper management.
  Mod+Y repeat=false hotkey-overlay-title="Wallpaper Menu" {
    spawn "osc-shell" "ipc" "call" "wallpaper" "toggle"
  }
  Mod+W hotkey-overlay-title="Next Wallpaper" {
    spawn "osc-shell" "ipc" "call" "wallpaper" "next"
  }
  Mod+Shift+W hotkey-overlay-title="Prev Wallpaper" {
    spawn "osc-shell" "ipc" "call" "wallpaper" "prev"
  }
  Mod+Shift+T repeat=false hotkey-overlay-title="Toggle Theme" {
    spawn "osc-shell" "ipc" "call" "darkMode" "toggle"
  }
  Mod+Shift+N repeat=false hotkey-overlay-title="Toggle Night Mode" {
    spawn "osc-shell" "ipc" "call" "nightLight" "toggle"
  }

  // Help & Documentation triggers.
  Mod+Alt+Slash repeat=false hotkey-overlay-title="Keybind Settings" {
    spawn "osc-shell" "ipc" "call" "plugin:keybind-cheatsheet" "toggle"
  }
  Mod+F1 repeat=false hotkey-overlay-title="Keybinds (Shell)" {
    spawn "osc-shell" "ipc" "call" "plugin:keybind-cheatsheet" "toggle"
  }
  Alt+F1 repeat=false hotkey-overlay-title="Keybinds (Niri)" { show-hotkey-overlay; }

  // ----------------------------------------------------------------------
  // Hardware Media Control (Volume / Brightness)
  // ----------------------------------------------------------------------
  XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Vol +" {
    spawn "osc-shell" "ipc" "call" "volume" "increase"
  }
  XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Vol -" {
    spawn "osc-shell" "ipc" "call" "volume" "decrease"
  }
  XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute" {
    spawn "osc-shell" "ipc" "call" "volume" "muteOutput"
  }
  XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mic Mute" {
    spawn "osc-shell" "ipc" "call" "volume" "muteInput"
  }

  XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Bright +" {
    spawn "osc-shell" "ipc" "call" "brightness" "increase"
  }
  XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Bright -" {
    spawn "osc-shell" "ipc" "call" "brightness" "decrease"
  }

  // ----------------------------------------------------------------------
  // Custom Media & Sound Routing
  // ----------------------------------------------------------------------
  Alt+A repeat=false hotkey-overlay-title="Switch Audio Output" {
    spawn "osc-soundctl" "switch"
  }
  Alt+Ctrl+A repeat=false hotkey-overlay-title="Switch Mic Input" {
    spawn "osc-soundctl" "switch-mic"
  }

  // Spotify integration.
  Alt+E repeat=false hotkey-overlay-title="Spotify Toggle" {
    spawn "osc-media" "spotify" "toggle"
  }
  Alt+Ctrl+N repeat=false hotkey-overlay-title="Spotify Next" {
    spawn "osc-media" "spotify" "next"
  }
  Alt+Ctrl+B repeat=false hotkey-overlay-title="Spotify Prev" {
    spawn "osc-media" "spotify" "prev"
  }

  // Local media (MPC) and Browser media.
  Alt+Ctrl+E repeat=false hotkey-overlay-title="MPC Toggle" {
    spawn "osc-media" "mpc" "toggle"
  }
  Alt+I repeat=false hotkey-overlay-title="VLC Toggle" {
    spawn "osc-media" "browser" "toggle"
  }

  // ----------------------------------------------------------------------
  // System Utility Tools
  // ----------------------------------------------------------------------
  Mod+Shift+C repeat=false hotkey-overlay-title="Color Picker" {
    spawn "/usr/bin/hyprpicker" "-a"
  }

  Mod+Ctrl+V repeat=false hotkey-overlay-title="Clipboard History" {
    spawn "osc-shell" "ipc" "call" "plugin:clipper" "toggle"
  }

  // Clipse history manager running in a floating terminal.
  Mod+Alt+V repeat=false hotkey-overlay-title="Clipse (Floating)" {
    spawn "uwsm" "app" "-a" "clipse" "--" "/usr/bin/kitty" "--class" "clipse" "-e" "clipse"
  }

  // Connectivity toggles.
  F10 repeat=false hotkey-overlay-title="Bluetooth Toggle" {
    spawn "bluetooth_toggle"
  }
  Alt+F12 repeat=false hotkey-overlay-title="VPN Toggle" {
    spawn "osc-mullvad" "toggle" "--with-blocky"
  }
  Mod+Alt+F12 repeat=false hotkey-overlay-title="VPN Slot Recycle" {
    spawn "osc-mullvad" "slot" "--hold" "recycle"
  }

  // Screenshots: Rec (Area), Region, Output (Screen), Window.
  Print repeat=false hotkey-overlay-title="Screenshot Rec" {
    spawn "screenshot" "rec"
  }
  Shift+Print repeat=false hotkey-overlay-title="Screenshot Area" {
    spawn "osc-shell" "ipc" "call" "plugin:screenshot" "takeScreenshot" "region"
  }
  Ctrl+Print repeat=false hotkey-overlay-title="Screenshot Screen" {
    spawn "osc-shell" "ipc" "call" "plugin:screenshot" "takeScreenshot" "output"
  }
  Alt+Print repeat=false hotkey-overlay-title="Screenshot Window" {
    spawn "osc-shell" "ipc" "call" "plugin:screenshot" "takeScreenshot" "window"
  }

  // Dynamic Screencasting helpers.
  Mod+Ctrl+Shift+W repeat=false hotkey-overlay-title="Cast Focused Window" {
    set-dynamic-cast-window
  }
  Mod+Ctrl+Alt+W repeat=false hotkey-overlay-title="Pick Cast Window" {
    spawn "niri-osc" "set" "cast" "pick"
  }
  Mod+Ctrl+Shift+M repeat=false hotkey-overlay-title="Cast Focused Monitor" {
    set-dynamic-cast-monitor
  }
  Mod+Ctrl+Shift+X repeat=false hotkey-overlay-title="Clear Cast Target" {
    clear-dynamic-cast-target
  }
  Mod+Ctrl+Alt+F repeat=false hotkey-overlay-title="Windowed Fullscreen" {
    toggle-windowed-fullscreen
  }

  // Config Reload & System Doctor.
  Mod+Ctrl+Alt+R repeat=false hotkey-overlay-title="Reload Config" {
    spawn "niri" "msg" "action" "load-config-file"
  }
  Mod+Ctrl+Alt+S repeat=false hotkey-overlay-title="Session Refresh" {
    spawn "niri-osc" "set" "env"
  }
  Mod+Ctrl+Alt+D repeat=false hotkey-overlay-title="Session Doctor" {
    spawn "uwsm" "app" "-a" "niri-doctor" "--" "/usr/bin/kitty" "--class" "niri-doctor" "-e" "bash" "-lc" "$HOME/.local/bin/niri-osc set doctor; echo; read -n 1 -s -r -p 'Press any key to close'"
  }

  // Toggle Wayland shortcut inhibition for games/remote-viewer.
  Mod+Ctrl+Escape allow-inhibiting=false repeat=false hotkey-overlay-title="Toggle Shortcut Inhibit" {
    toggle-keyboard-shortcuts-inhibit
  }

  // ----------------------------------------------------------------------
  // Specific Application Launchers
  // ----------------------------------------------------------------------
  Alt+T allow-inhibiting=false repeat=false hotkey-overlay-title="KKENP Start" {
    spawn "uwsm" "app" "-a" "start-kkenp" "--" "start-kkenp"
  }
  Alt+N allow-inhibiting=false repeat=false hotkey-overlay-title="Notes (Anotes)" {
    spawn "uwsm" "app" "-a" "anotes" "--" "anotes"
  }
  Mod+Alt+Return repeat=false hotkey-overlay-title="SemsuMo Daily" {
    spawn "semsumo-daily"
  }
  Mod+Return repeat=false hotkey-overlay-title="Dropdown Terminal" {
    spawn "niri-osc" "drop" "kitty" "--class" "dropdown-terminal"
  }
  Alt+Space repeat=false hotkey-overlay-title="Custom Commands" {
    spawn "osc-shell" "ipc" "call" "plugin:custom-commands" "toggle"
  }
  Mod+Alt+Space repeat=false hotkey-overlay-title="Rofi Launcher" {
    spawn "uwsm" "app" "-a" "rofi-launcher" "--" "rofi-launcher"
  }
  Mod+Shift+S repeat=false hotkey-overlay-title="Sticky Toggle" {
    spawn "niri-float-sticky" "toggle-active"
  }

  // File Managers: Nemo (GUI), Yazi (Terminal).
  Mod+Ctrl+F repeat=false hotkey-overlay-title="File Manager (Nemo)" {
    spawn "uwsm" "app" "-a" "nemo" "--" "nemo"
  }
  Alt+Ctrl+F repeat=false hotkey-overlay-title="File Manager (Yazi)" {
    spawn "uwsm" "app" "-a" "yazi" "--" "kitty" "-e" "yazi"
  }

  Mod+T repeat=false hotkey-overlay-title="Terminal" {
    spawn "uwsm" "app" "-a" "kitty" "--" "kitty"
  }

  // MPV Playback & Management helpers.
  Alt+U repeat=false hotkey-overlay-title="MPV Playback" {
    spawn "osc-media" "mpv" "toggle"
  }
  Mod+Ctrl+Y repeat=false hotkey-overlay-title="MPV Play YouTube" {
    spawn "mpv-manager" "play-yt"
  }
  Ctrl+Alt+Y repeat=false hotkey-overlay-title="MPV Stick" {
    spawn "mpv-manager" "stick"
  }
  Shift+Alt+Y repeat=false hotkey-overlay-title="MPV Move" {
    spawn "mpv-manager" "move"
  }
  Mod+Ctrl+F11 repeat=false hotkey-overlay-title="MPV Save YT" {
    spawn "mpv-manager" "save-yt"
  }
  Mod+Ctrl+F12 repeat=false hotkey-overlay-title="MPV Wallpaper" {
    spawn "mpv-manager" "wallpaper"
  }
  Ctrl+Alt+P repeat=false hotkey-overlay-title="Power Profile Toggle" {
    spawn "power-profile"
  }
  Ctrl+Alt+M repeat=false hotkey-overlay-title="Wiremix" {
    spawn "osc-wiremix"
  }

  // BEGIN OSC_NIRI_WORKSPACE_SHORTCUTS
  // ----------------------------------------------------------------------
  // Workspace Navigation (1..9)
  // ----------------------------------------------------------------------
  Mod+1 hotkey-overlay-title="Workspace 1: Kenp" { focus-workspace "1"; }
  Mod+2 hotkey-overlay-title="Workspace 2: Term" { focus-workspace "2"; }
  Mod+3 hotkey-overlay-title="Workspace 3: AI" { focus-workspace "3"; }
  Mod+4 hotkey-overlay-title="Workspace 4: CompecTA" { focus-workspace "4"; }
  Mod+5 hotkey-overlay-title="Workspace 5: Chat" { focus-workspace "5"; }
  Mod+6 hotkey-overlay-title="Workspace 6: Media" { focus-workspace "6"; }
  Mod+7 hotkey-overlay-title="Workspace 7: Utility" { focus-workspace "7"; }
  Mod+8 hotkey-overlay-title="Workspace 8: Music" { focus-workspace "8"; }
  Mod+9 hotkey-overlay-title="Workspace 9: Social" { focus-workspace "9"; }

  // Move current column to workspace (1..9).
  Mod+Shift+1 hotkey-overlay-title="Move To WS 1: Kenp" { move-column-to-workspace "1"; }
  Mod+Shift+2 hotkey-overlay-title="Move To WS 2: Term" { move-column-to-workspace "2"; }
  Mod+Shift+3 hotkey-overlay-title="Move To WS 3: AI" { move-column-to-workspace "3"; }
  Mod+Shift+4 hotkey-overlay-title="Move To WS 4: CompecTA" { move-column-to-workspace "4"; }
  Mod+Shift+5 hotkey-overlay-title="Move To WS 5: Chat" { move-column-to-workspace "5"; }
  Mod+Shift+6 hotkey-overlay-title="Move To WS 6: Media" { move-column-to-workspace "6"; }
  Mod+Shift+7 hotkey-overlay-title="Move To WS 7: Utility" { move-column-to-workspace "7"; }
  Mod+Shift+8 hotkey-overlay-title="Move To WS 8: Music" { move-column-to-workspace "8"; }
  Mod+Shift+9 hotkey-overlay-title="Move To WS 9: Social" { move-column-to-workspace "9"; }

  // ----------------------------------------------------------------------
  // "Here" Actions (Workspace shortcuts for specific apps)
  // ----------------------------------------------------------------------
  Alt+1 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: Kenp" { spawn "niri-osc" "set" "here" "Kenp"; }
  Alt+2 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: TmuxKenp" { spawn "niri-osc" "set" "here" "TmuxKenp"; }
  Alt+3 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: Ai" { spawn "niri-osc" "set" "here" "Ai"; }
  Alt+4 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: CompecTA" { spawn "niri-osc" "set" "here" "CompecTA"; }
  Alt+5 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: WebCord" { spawn "niri-osc" "set" "here" "WebCord"; }
  Alt+6 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: Telegram" { spawn "niri-osc" "set" "here" "org.telegram.desktop"; }
  Alt+7 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: YouTube" { spawn "niri-osc" "set" "here" "brave-youtube.com__-Default"; }
  Alt+8 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: Spotify" { spawn "niri-osc" "set" "here" "spotify"; }
  Alt+9 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: Ferdium" { spawn "niri-osc" "set" "here" "ferdium"; }
  Alt+0 allow-inhibiting=false repeat=false hotkey-overlay-title="Here: ALL" { spawn "niri-osc" "set" "here" "all"; }

  // Global window rearrangement.
  Mod+Alt+0 allow-inhibiting=false repeat=false hotkey-overlay-title="Go (Arrange Windows)" { spawn "niri-osc" "set" "go"; }
  // END OSC_NIRI_WORKSPACE_SHORTCUTS

  // ----------------------------------------------------------------------
  // Advanced Navigation & Monitor Focus
  // ----------------------------------------------------------------------
  Mod+Ctrl+C repeat=false hotkey-overlay-title="Move to Empty WS" { move-window-to-workspace 255; }
  Mod+Page_Up hotkey-overlay-title="Move Win WS Up" { move-window-to-workspace-up; }
  Mod+Page_Down hotkey-overlay-title="Move Win WS Down" { move-window-to-workspace-down; }

  // Wheel scroll for workspace and monitor navigation.
  Mod+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="WS Down" { focus-workspace-down; }
  Mod+WheelScrollUp cooldown-ms=150 hotkey-overlay-title="WS Up" { focus-workspace-up; }
  Mod+WheelScrollRight hotkey-overlay-title="Focus Right" { focus-column-right; }
  Mod+WheelScrollLeft hotkey-overlay-title="Focus Left" { focus-column-left; }

  // Monitor-specific navigation.
  Mod+A repeat=false hotkey-overlay-title="Focus Next Monitor" {
    spawn "niri" "msg" "action" "focus-monitor-next"
  }
  Mod+Alt+H hotkey-overlay-title="Monitor Left" { focus-monitor-left; }
  Mod+Alt+L hotkey-overlay-title="Monitor Right" { focus-column-right; }
  Mod+Alt+K hotkey-overlay-title="Monitor Up" { focus-monitor-up; }
  Mod+Alt+J hotkey-overlay-title="Monitor Down" { focus-monitor-down; }

  Mod+Ctrl+A repeat=false hotkey-overlay-title="Move Window Next Monitor" {
    spawn "niri-osc" "set" "monitor-smart-next"
  }
  Mod+Escape repeat=false hotkey-overlay-title="Move Window Next Monitor" {
    spawn "niri-osc" "set" "monitor-smart-next"
  }

  // Cross-monitor window movement.
  Mod+Alt+Shift+Left hotkey-overlay-title="Move to Monitor Left" { move-column-to-monitor-left; }
  Mod+Alt+Shift+Right hotkey-overlay-title="Move to Monitor Right" { move-column-to-monitor-right; }
  Mod+Ctrl+Up hotkey-overlay-title="Move to Monitor Up" { move-column-to-monitor-up; }
  Mod+Ctrl+Down hotkey-overlay-title="Move to Monitor Down" { move-column-to-monitor-down; }
}

// ========================================================================
// WINDOW RULES
// ========================================================================
// General rules for corner radius and geometry.
window-rule {
  geometry-corner-radius 12
  clip-to-geometry true
}

// Visual feedback for floating vs tiled windows.
window-rule {
  match is-floating=true
  shadow {
    on
  }
}
window-rule {
  match is-floating=false
  shadow {
    on
    color "#00000060"
    offset x=0 y=4
    spread 0
    softness 16
  }
}

// Specific Application Rules (Floating, Sizing, Placement).
window-rule {
  match app-id=r#"^org\.quickshell$"#
  open-floating true
}

window-rule {
  match app-id=r#"^steam_app_\d+$"#
  variable-refresh-rate true
}

// Hide XWayland video bridge from view.
window-rule {
  match app-id="xwaylandvideobridge"
  open-floating true
  open-focused false
  opacity 0.0
  default-column-width { fixed 1; }
  default-window-height { fixed 1; }
}

// PiP (Picture-in-Picture) configurations for browsers and MPV.
window-rule {
  match title=r#"(?i)^picture[- ]in[- ]picture( - mpv)?$"#
  open-floating true
  default-column-width { fixed 640; }
  default-window-height { fixed 360; }
  default-floating-position x=32 y=96 relative-to="top-right"
  opacity 1.0
  open-focused true
}

window-rule {
  match app-id=r#"^mpv$"#
  exclude title=r#"^Picture-in-Picture( - mpv)?$"#
  variable-refresh-rate true
  open-floating true
  default-column-width { fixed 640; }
  default-window-height { fixed 360; }
  default-floating-position x=32 y=96 relative-to="top-right"
  min-width 640
  max-width 640
  min-height 360
  max-height 360
  opacity 1.0
  open-focused true
}

// Floating rules for system dialogs and portals.
window-rule {
  match title=r#"^(Open File|File Upload|Save As|Confirm to replace files|File Operation Progress|Extract archive|Compress\.\.\.)$"#
  open-floating true
  default-column-width { proportion 0.50; }
  default-window-height { proportion 0.75; }
  open-focused true
}

window-rule {
  match app-id=r#"^xdg-desktop-portal-(wlr|gnome|gtk)$"#
  exclude app-id=r#"^Kenp$"#
  open-floating true
  default-column-width { proportion 0.50; }
  default-window-height { proportion 0.75; }
  open-focused true
}

// Floating rules for utility apps (Calculator, Polkit, etc).
window-rule {
  match app-id=r#"^(org\.gnome\.Calculator|kcalc)$"#
  open-floating true
  default-column-width { fixed 400; }
  default-window-height { fixed 600; }
  open-focused true
}

window-rule {
  match app-id=r#"^(polkit-gnome-authentication-agent-1|gcr-prompter)$"#
  open-floating true
  default-column-width { fixed 600; }
  default-window-height { fixed 240; }
  open-focused true
}

// Floating rules for system management tools.
window-rule {
  match app-id=r#"^(blueman-manager|nm-connection-editor|org\.gnome\.Settings|gnome-disks|pavucontrol)$"#
  open-floating true
  default-column-width { fixed 900; }
  default-window-height { fixed 650; }
  open-focused true
}

// Sidebar-style tools (Clipse, Wiremix, CopyQ).
window-rule {
  match app-id=r#"^(clipse|clipse-gui|wiremix|org\.pulseaudio\.pavucontrol|io\.ente\.auth|com\.github\.hluk\.copyq|copyq)$"#
  open-floating true
  default-column-width { proportion 0.25; }
  default-window-height { proportion 0.80; }
  default-floating-position x=32 y=144 relative-to="top-right"
  open-focused true
}

// Scrcpy optimized phone-ratio placement.
window-rule {
  match app-id=r#"^scrcpy$"#
  open-floating true
  default-column-width { fixed 432; }
  default-window-height { fixed 960; }
  default-floating-position x=32 y=144 relative-to="top-right"
  open-focused true
}

// Dropdown terminal styling.
window-rule {
  match app-id="dropdown-terminal"
  open-floating true
  default-column-width { proportion 0.8; }
  default-window-height { fixed 600; }
  default-floating-position x=0 y=20 relative-to="top"
  border {
    off
  }
  shadow {
    on
    spread 10
    softness 40
    color "#00000080"
  }
}

// BEGIN OSC_NIRI_WORKSPACE_RULES
// Default Workspace placements by application ID.
window-rule {
  match app-id=r#"^Kenp$"#
  open-on-workspace "1"
}
window-rule {
  match app-id=r#"^(TmuxKenp|kitty|org\.wezfurlong\.wezterm)$"#
  open-on-workspace "2"
}
window-rule {
  match app-id=r#"^(Ai|Nil)$"#
  open-on-workspace "3"
}
window-rule {
  match app-id=r#"^CompecTA$"#
  open-on-workspace "4"
}
window-rule {
  match app-id=r#"^(discord|WebCord|audacious)$"#
  open-on-workspace "5"
}
window-rule {
  match app-id=r#"^(Exclude|org\.telegram\.desktop|vlc|remote-viewer)$"#
  open-on-workspace "6"
}
window-rule {
  match app-id=r#"^(transmission|org\.keepassxc\.KeePassXC|(brave-youtube|chrome-youtube)\.com__-Default)$"#
  open-on-workspace "7"
}
window-rule {
  match app-id=r#"^(spotify|Spotify|com\.spotify\.Client)$"#
  open-on-workspace "8"
}
window-rule {
  match app-id=r#"^(ferdium|Ferdium|com\.rtosta\.zapzap|(Whats|chrome-web\.whatsapp\.com__-Default))$"#
  open-on-workspace "9"
}
// END OSC_NIRI_WORKSPACE_RULES

// Privacy: Block sensitive applications from appearing in screenshots or screencasts.
window-rule {
  match app-id=r#"^(org\.keepassxc\.KeePassXC|io\.ente\.auth|clipse|copyq|gcr-prompter|polkit-gnome-authentication-agent-1)$"#
  block-out-from "screencast"
}
window-rule {
  match app-id=r#"^(org\.keepassxc\.KeePassXC|io\.ente\.auth|clipse|copyq|gcr-prompter|polkit-gnome-authentication-agent-1)$"#
  block-out-from "screen-capture"
}
window-rule {
  match app-id=r#"^(discord|WebCord|ferdium|Ferdium|org\.telegram\.desktop|Signal|Slack)$"#
  block-out-from "screencast"
}
window-rule {
  match app-id=r#"^(discord|WebCord|ferdium|Ferdium|org\.telegram\.desktop|Signal|Slack)$"#
  block-out-from "screen-capture"
}

// Visual feedback when a window is being actively cast.
window-rule {
  match is-window-cast-target=true
  focus-ring {
    active-color "#f38ba8"
    inactive-color "#7d0d2d"
  }
  opacity 1.0
}

// ------------------------------------------------------------------------
// LAYER RULES (UI Components)
// ------------------------------------------------------------------------
layer-rule {
  match namespace=r#"(^|.*[:\-])(bar|dock|panel).*$"#
  geometry-corner-radius 0
}

layer-rule {
  match namespace=r#"(^|.*[:\-])(launcher|osd|popup).*$"#
  shadow {
    on
    color "#00000060"
    spread 2
    softness 12
  }
}

layer-rule {
  match namespace="^notifications$"
  geometry-corner-radius 12
}
layer-rule {
  match namespace="^notifications$"
  block-out-from "screencast"
}
layer-rule {
  match namespace="^notifications$"
  block-out-from "screen-capture"
}

// ------------------------------------------------------------------------
// ANIMATIONS
// ------------------------------------------------------------------------
animations {
  // SNAPPY MOTION PROFILE: High stiffness for instant feedback.

  workspace-switch {
    spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
  }
  window-open {
    spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
  }
  window-close {
    spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
  }
  window-resize {
    spring damping-ratio=0.8 stiffness=1000 epsilon=0.0001
  }

  horizontal-view-movement {
    spring damping-ratio=0.92 stiffness=600 epsilon=0.0001
  }
  window-movement {
    spring damping-ratio=0.85 stiffness=600 epsilon=0.0001
  }
  
  overview-open-close {
    spring damping-ratio=0.92 stiffness=1000 epsilon=0.0001
  }
}

// ------------------------------------------------------------------------
// GESTURES
// ------------------------------------------------------------------------
gestures {
  dnd-edge-view-scroll {
    trigger-width 30
    delay-ms 100
    max-speed 1500
  }
  dnd-edge-workspace-switch {
    trigger-height 42
    delay-ms 125
    max-speed 1300
  }
  hot-corners {
    off
  }
}
