}

window-rule {
  match app-id=r#"^(ferdium|Ferdium)$"#
  open-on-workspace "9"
  default-column-width { proportion 0.85; }
}
window-rule {
  match app-id=r#"^com\.rtosta\.zapzap$"#
  open-on-workspace "9"
}
window-rule {
  match app-id=r#"^(Whats|chrome-web\.whatsapp\.com__-Default)$"#
