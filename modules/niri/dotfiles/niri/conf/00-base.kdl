cursor {
  // Apply the system-wide cursor theme directly in the compositor, not just via env.
  xcursor-theme "capitaine-cursors"
  xcursor-size 24
  // Hide cursor during keyboard input for better focus.
  hide-when-typing
  // Auto-hide after 1 second of inactivity to keep workspace clean.
  hide-after-inactive-ms 1000
}

// Request applications to skip Client Side Decorations (CSD) where possible.
prefer-no-csd

hotkey-overlay {
  // Skip showing the help overlay at startup for a cleaner entry.
  skip-at-startup
  // Hide keys that aren't currently bound to avoid clutter.
  hide-not-bound
}

overview {
  // Zoom level for the workspace overview.
  zoom 0.25
  backdrop-color "#313244"
  workspace-shadow {
    softness 40
    spread 12
    offset x=0 y=12
    color "#00000050"
  }
}

// Integrate wallpaper surfaces into the overview backdrop for visual depth.
layer-rule {
  match namespace="^wallpaper$"
  place-within-backdrop true
}

input {
  // Cycle workspaces automatically when reaching the boundaries.
  workspace-auto-back-and-forth
  // Enable focus-follows-mouse with a high threshold for intentionality.
  focus-follows-mouse max-scroll-amount="90%"
  // Warp mouse to focus for deterministic navigation.
  warp-mouse-to-focus mode="center-xy"

  keyboard {
    xkb {
      layout "tr"
      variant "f"
      options "ctrl:nocaps"
    }
    // Responsive repeat rates for fast terminal/Vim navigation.
    repeat-delay 250
    repeat-rate 35
  }

  touchpad {
    tap
    dwt
    dwtp
    drag-lock
    tap-button-map "left-right-middle"
    middle-emulation
    click-method "clickfinger"
    accel-profile "adaptive"
    accel-speed 1.0
    scroll-method "two-finger"
    scroll-factor 1.0
  }

  mouse {
    accel-profile "adaptive"
    accel-speed 0.0
    scroll-factor 1.0
  }

  trackpoint {
    accel-profile "adaptive"
    accel-speed 0.0
    middle-emulation
    scroll-method "on-button-down"
    scroll-button 273
    scroll-button-lock
  }
}

debug {
  deactivate-unfocused-windows
}

switch-events {
  lid-close {
    spawn "niri-osc" "set" "lock-and-suspend"
  }

  // Re-run layout arrangement after dock/undock events caused by opening the lid.
  lid-open {
    spawn "systemctl" "--user" "start" "--no-block" "niri-arrange.service"
  }
}
