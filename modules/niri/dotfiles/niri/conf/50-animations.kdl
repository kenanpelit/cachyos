animations {
  overview-open-close {
    spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
  }

  workspace-switch {
    spring damping-ratio=1.0 stiffness=700 epsilon=0.0001
  }

  window-open {
    duration-ms 180
    curve "ease-out-expo"
  }

  window-close {
    duration-ms 160
    curve "ease-out-quad"
  }

  window-resize {
    spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
  }

  horizontal-view-movement {
    spring damping-ratio=1.0 stiffness=750 epsilon=0.0001
  }

  window-movement {
    spring damping-ratio=1.0 stiffness=750 epsilon=0.0001
  }
}
