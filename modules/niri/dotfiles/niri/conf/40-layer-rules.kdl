layer-rule {
  match namespace=r#"(^|.*[:\-])(bar|dock|panel).*$"#
  geometry-corner-radius 0
}

layer-rule {
  match namespace=r#"^(notifications|noctalia-notifications-.+|noctalia-toast-.+)$"#
  block-out-from "screencast"
}

layer-rule {
  match namespace=r#"^(notifications|noctalia-notifications-.+|noctalia-toast-.+)$"#
  block-out-from "screen-capture"
}
