window-rule {
  match app-id=r#"^(org\.keepassxc\.KeePassXC|KeePassXC|com\.bitwarden\.desktop|Bitwarden|com\.1password\.1Password|1Password|io\.ente\.auth|org\.gnome\.World\.Secrets|org\.gnome\.seahorse\.Application|seahorse|kwalletmanager5|kwalletmanager|pinentry.*|gcr-prompter|polkit-gnome-authentication-agent-1|clipse|copyq)$"#
  block-out-from "screencast"
}

window-rule {
  match app-id=r#"^(org\.keepassxc\.KeePassXC|KeePassXC|com\.bitwarden\.desktop|Bitwarden|com\.1password\.1Password|1Password|io\.ente\.auth|org\.gnome\.World\.Secrets|org\.gnome\.seahorse\.Application|seahorse|kwalletmanager5|kwalletmanager|pinentry.*|gcr-prompter|polkit-gnome-authentication-agent-1|clipse|copyq)$"#
  block-out-from "screen-capture"
}

window-rule {
  match app-id=r#"^(discord|WebCord|ferdium|Ferdium|org\.telegram\.desktop|Signal|Slack)$"#
  block-out-from "screencast"
}

window-rule {
  match app-id=r#"^(discord|WebCord|ferdium|Ferdium|org\.telegram\.desktop|Signal|Slack)$"#
  block-out-from "screen-capture"
}

window-rule {
  match title=r#"(?i).*(password|passphrase|authentication|unlock|secret|two-factor|verification code|one-time|otp).*"#
  block-out-from "screencast"
}

window-rule {
  match title=r#"(?i).*(password|passphrase|authentication|unlock|secret|two-factor|verification code|one-time|otp).*"#
  block-out-from "screen-capture"
}

window-rule {
  match app-id=r#"(?i)^(firefox|librewolf|zen|brave.*|chromium|google-chrome.*|microsoft-edge.*|helium.*)$"# title=r#"(?i).*(private browsing|private window|incognito|inprivate).*"#
  block-out-from "screencast"
}

window-rule {
  match app-id=r#"(?i)^(firefox|librewolf|zen|brave.*|chromium|google-chrome.*|microsoft-edge.*|helium.*)$"# title=r#"(?i).*(private browsing|private window|incognito|inprivate).*"#
  block-out-from "screen-capture"
}
