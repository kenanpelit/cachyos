layout {
  gaps 6
  center-focused-column "on-overflow"
  always-center-single-column

  border {
    off
  }

  preset-window-heights {
    proportion 0.500
    proportion 0.618
    proportion 0.786
    proportion 0.900
    proportion 1.000
  }
}

recent-windows {
  debounce-ms 450
  open-delay-ms 100

  binds {
    Mod+Tab { next-window scope="output"; }
    Mod+Shift+Tab { previous-window scope="output"; }
    Mod+Ctrl+Tab { next-window filter="app-id" scope="workspace"; }
    Mod+Ctrl+Shift+Tab { previous-window filter="app-id" scope="workspace"; }
  }
}
