// Generated from modules/niri/effects/background-policy.json.
// Update the policy and rerun modules/niri/scripts/render-background-effects.sh.
// Source checksum: dcdc4f7c17699ca4149ed2e4740c5df4f0fc51fdcdfefd2904d66abe41075152

// Niri 26.04 background effects. Keep this conservative: xray blur is cheap,
// while non-xray blur is still experimental and intentionally not enabled.

blur {
  passes 2
  offset 3
  noise 0.01
  saturation 1.15
}

// Integrate static and Noctalia-backed wallpapers into the overview backdrop.
layer-rule {
  match namespace=r#"^(wallpaper|noctalia-wallpaper-.+|noctalia-wallpaper-video-.+|noctalia-parallax-.+)$"#
  place-within-backdrop true
}

// Noctalia shell surfaces that are allowed to use compositor-side blur.
// Overview, launcher, OSD, and capture overlays are intentionally excluded.
layer-rule {
  match namespace=r#"^noctalia-(popup|popupmenu|control|control-center|settings|session-menu|selection-menu).*$"#

  geometry-corner-radius 14

  background-effect {
    blur true
  }

  popups {
    geometry-corner-radius 12

    background-effect {
      blur true
    }
  }
}

// Transient feedback and capture surfaces must stay readable.
layer-rule {
  match namespace=r#"^noctalia[-:]niri-overview-launcher.*$"#
  match namespace=r#"^noctalia:(niri-overview-launcher).*$"#
  match namespace=r#"^noctalia-launcher-overlay.*$"#
  match namespace=r#"^noctalia-osd.*$"#
  match namespace=r#"^(noctalia-region-selector|noctalia-record|noctalia-measure|noctalia-annotate|noctalia-mirror|noctalia-pin|noctalia-shell:regionSelector)$"#

  background-effect {
    blur false
  }

  popups {
    background-effect {
      blur false
    }
  }
}
