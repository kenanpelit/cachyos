output "DP-3" {
  mode "2560x1440@59"
  scale 1
  position x=0 y=0
  focus-at-startup
  backdrop-color "#1e1e2e"

  hot-corners {
    bottom-right
  }

  layout {
    default-column-width { proportion 0.786; }

    preset-column-widths {
      proportion 0.333
      proportion 0.500
      proportion 0.667
      proportion 0.800
      proportion 1.000
    }
  }
}

output "eDP-1" {
  mode "1920x1200@60"
  scale 1
  position x=320 y=1440
  variable-refresh-rate on-demand=true
  backdrop-color "#181825"

  hot-corners {
    off
  }

  layout {
    default-column-width { proportion 0.786; }

    preset-column-widths {
      proportion 0.333
      proportion 0.500
      proportion 0.667
      proportion 0.800
      proportion 1.000
    }
  }
