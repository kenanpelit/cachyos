[Unit]
Description=Niri login prompts warmup
After=graphical-session.target niri-daemons.target niri-bootstrap.service
PartOf=niri-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/osc-login-prompts

[Service]
Type=oneshot
TimeoutStartSec=30
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin:%h/bin
Environment=OSC_LOGIN_PROMPTS_DELAY=3
Environment=OSC_LOGIN_PROMPTS_SESSION=Niri Login
ExecStart=/usr/bin/bash -lc "%h/.local/bin/osc-login-prompts --once"
StandardOutput=journal
StandardError=journal

#[Install]
#WantedBy=niri-daemons.target
