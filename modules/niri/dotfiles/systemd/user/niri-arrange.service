[Unit]
Description=Niri initial workspace arrangement
After=niri-bootstrap.service niri-audio-init.service
Before=niri-daemons.target
PartOf=niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/niri-arrange

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/niri-arrange
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
