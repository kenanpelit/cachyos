[Unit]
Description=Snapper tools check (Niri)
After=niri-daemons.target
PartOf=niri-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=/usr/bin/snapper-tools

[Service]
Type=oneshot
# Match upstream autostart behavior:
# only run when booted into a snapshot environment.
ExecStart=/usr/bin/bash -lc "grep -q .snapshots /proc/cmdline || exit 0; sleep 3; /usr/bin/snapper-tools --autostart || true"
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
