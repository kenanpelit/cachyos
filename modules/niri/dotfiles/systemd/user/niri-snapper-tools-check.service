[Unit]
Description=Snapper tools check (Niri)
After=graphical-session.target niri-bootstrap.service
PartOf=niri-daemons.target graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=/usr/bin/snapper-tools

[Service]
Type=oneshot
# Match upstream autostart behavior:
# only run when booted into a snapshot environment.
ExecStart=%h/.local/bin/niri-snapper-tools-check
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
