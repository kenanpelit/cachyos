[Unit]
Description=Niri bootstrap (init)
Wants=pipewire.service wireplumber.service
After=graphical-session.target wayland-wm@niri\x2dsession.service wayland-session-waitenv.service niri-session-env.service pipewire.service wireplumber.service
Before=niri-daemons.target
PartOf=niri-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/niri-bootstrap

[Service]
Type=oneshot
TimeoutStartSec=60
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/niri-bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
