[Unit]
Description=Niri audio initialization
Wants=pipewire.service wireplumber.service
After=niri-bootstrap.service pipewire.service wireplumber.service
PartOf=niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/osc-soundctl

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=TERM=dumb
ExecStart=%h/.local/bin/osc-soundctl init
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
