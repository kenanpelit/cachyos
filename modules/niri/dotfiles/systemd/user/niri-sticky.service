[Unit]
Description=Niri sticky daemon
After=graphical-session.target niri-bootstrap.service
PartOf=niri-daemons.target graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
Type=simple
ExecStart=/usr/bin/bash -lc "%h/.local/bin/niri-osc sticky"
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
