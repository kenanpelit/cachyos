[Unit]
Description=Niri shell backend ensure
After=niri-bootstrap.service dbus.service
Before=niri-status-notifier-ready.service
PartOf=niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/osc-shell

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=OSC_SHELL_STARTUP=1
ExecStart=%h/.local/bin/osc-shell ensure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
