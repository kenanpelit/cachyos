[Unit]
Description=Polkit authentication agent (polkit-gnome)
BindsTo=wayland-wm@niri\x2dsession.service
After=graphical-session.target wayland-wm@niri\x2dsession.service niri-bootstrap.service dbus.service
PartOf=niri-daemons.target graphical-session.target wayland-wm@niri\x2dsession.service
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ExecStart=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
SuccessExitStatus=1
Restart=on-abnormal
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
