[Unit]
Description=Polkit authentication agent (polkit-gnome)
After=graphical-session.target niri-daemons.target
PartOf=niri-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
ExecCondition=/usr/bin/bash -lc 'backend="$("%h/.local/bin/osc-shell" backend niri 2>/dev/null || osc-shell backend niri 2>/dev/null || echo noctalia)"; [[ "$backend" == "noctalia" ]] && exit 1; pgrep -u "$(id -u)" -f "polkit-gnome-authentication-agent-1" >/dev/null && exit 1 || exit 0'
ExecStart=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
