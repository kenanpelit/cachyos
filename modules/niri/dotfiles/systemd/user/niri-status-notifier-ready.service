[Unit]
Description=Niri status notifier watcher readiness gate
After=graphical-session.target niri-bootstrap.service niri-shell-ensure.service dbus.service
PartOf=niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=NIRI_SOCKET
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/niri-osc

[Service]
Type=oneshot
TimeoutStartSec=25
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=STATUS_NOTIFIER_READY_LOG_TAG=niri-status-notifier-ready
ExecStart=%h/.local/bin/niri-osc set status-notifier-ready
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
