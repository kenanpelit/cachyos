[Unit]
Description=Niri session runtime environment sync
After=graphical-session.target wayland-wm@niri\x2dsession.service wayland-session-waitenv.service dbus.service
Before=niri-bootstrap.service niri-audio-init.service niri-arrange.service niri-shell-ensure.service niri-daemons.target niri-post-daemons.target niri-session-ready.target
PartOf=niri-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/niri-session-init

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/niri-session-init --no-start-target
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-session.target
