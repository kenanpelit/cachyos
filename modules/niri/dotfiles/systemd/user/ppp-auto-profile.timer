[Unit]
Description=Periodic power profile chooser
PartOf=graphical-session.target

[Timer]
# İlk çalışma: timer aktif olduktan 30 saniye sonra
OnActiveSec=30s
# Sonraki çalışmalar: Her 15 saniyede bir
OnUnitActiveSec=15s
AccuracySec=1s
Unit=ppp-auto-profile.service

[Install]
WantedBy=graphical-session.target
