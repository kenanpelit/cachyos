[Unit]
Description=NetworkManager applet (Niri)
After=graphical-session.target niri-bootstrap.service dbus.service
PartOf=niri-daemons.target graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
Type=simple
Environment=GDK_BACKEND=wayland,x11
ExecStart=/usr/bin/nm-applet --indicator
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-daemons.target
