{
  "workspaces": [
    {
      "id": "1",
      "name": "Kenp",
      "here": {
        "label": "Kenp",
        "target": "Kenp"
      },
      "focus": {
        "regex": "^Kenp$"
      },
      "routes": [
        {
          "appIdRegex": "^Kenp$"
        }
      ]
    },
    {
      "id": "2",
      "name": "Term",
      "here": {
        "label": "TmuxKenp",
        "target": "TmuxKenp"
      },
      "focus": {
        "regex": "^TmuxKenp$"
      },
      "routes": [
        {
          "appIdRegex": "^(TmuxKenp|kitty)$",
          "titleRegex": "^Tmux$"
        }
      ],
      "layout": {
        "lines": [
          "default-column-display \"tabbed\""
        ]
      }
    },
    {
      "id": "3",
      "name": "AI",
      "here": {
        "label": "Ai",
        "target": "Ai"
      },
      "focus": {
        "regex": "^Ai$"
      },
      "routes": [
        {
          "appIdRegex": "^(Ai|Nil)$"
        }
      ]
    },
    {
      "id": "4",
      "name": "Work",
      "here": {
        "label": "CompecTA",
        "target": "CompecTA"
      },
      "focus": {
        "regex": "^CompecTA$"
      },
      "routes": [
        {
          "appIdRegex": "^CompecTA$"
        }
      ]
    },
    {
      "id": "5",
      "name": "Chat",
      "here": {
        "label": "WebCord",
        "target": "WebCord"
      },
      "focus": {
        "regex": "^WebCord$"
      },
      "routes": [
        {
          "appIdRegex": "^(discord|WebCord|audacious)$"
        }
      ]
    },
    {
      "id": "6",
      "name": "Media",
      "here": {
        "label": "Telegram",
        "target": "org.telegram.desktop"
      },
      "focus": {
        "regex": "^(org\\.telegram\\.desktop|TelegramDesktop)$"
      },
      "routes": [
        {
          "appIdRegex": "^(Exclude|org\\.telegram\\.desktop|vlc|remote-viewer)$"
        }
      ],
      "layout": {
        "lines": [
          "default-column-width { proportion 1.000; }",
          "center-focused-column \"always\""
        ]
      }
    },
    {
      "id": "7",
      "name": "Utility",
      "here": {
        "label": "YouTube",
        "target": "brave-youtube.com__-Default"
      },
      "focus": {
        "regex": "^brave-youtube\\.com__-Default$"
      },
      "routes": [
        {
          "appIdRegex": "^(transmission|org\\.keepassxc\\.KeePassXC|(brave-youtube|chrome-youtube)\\.com__-Default)$"
        }
      ]
    },
    {
      "id": "8",
      "name": "Music",
      "here": {
        "label": "Spotify",
        "target": "spotify"
      },
      "focus": {
        "regex": "^(spotify|Spotify|com\\.spotify\\.Client)$"
      },
      "routes": [
        {
          "appIdRegex": "^(spotify|Spotify|com\\.spotify\\.Client)$"
        }
      ]
    },
    {
      "id": "9",
      "name": "Social",
      "here": {
        "label": "Ferdium",
        "target": "ferdium"
      },
      "focus": {
        "regex": "^(ferdium|Ferdium)$"
      },
      "routes": [
        {
          "appIdRegex": "^(ferdium|Ferdium|com\\.rtosta\\.zapzap|(Whats|chrome-web\\.whatsapp\\.com__-Default))$"
        }
      ]
    }
  ]
}
