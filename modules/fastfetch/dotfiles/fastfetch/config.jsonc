{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "cachyos",
    "type": "small",
    "padding": {
      "top": 2,
      "right": 6,
    },
  },

  "display": {
    "separator": " ",
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 2,
    },
    "freq": {
      "ndigits": 2,
    },
    "percent": {
      "type": 1,
    },
    "key": {
      "width": 14,
    },
  },

  "modules": [
    {
      "type": "title",
      "format": "{#36}{user-name}{#90}@{#38}{host-name}",
    },

    "break",

    {
      "type": "custom",
      "format": "{#90}╭─ {#33}󰧨 Hardware {#90}──────────────────────────────────────────────╮",
    },

    {
      "type": "cpu",
      "key": " 󰻠 CPU",
      "keyColor": "33",
      "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}",
    },
    {
      "type": "gpu",
      "key": " 󰍛 GPU",
      "keyColor": "33",
      "format": "{name}",
    },
    {
      "type": "display",
      "key": " 󰹑 Disp",
      "keyColor": "33",
      "format": "{width}x{height} @ {refresh-rate}Hz",
    },
    {
      "type": "memory",
      "key": " 󰑭 RAM",
      "keyColor": "33",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "  Disk",
      "keyColor": "33",
      "format": "{size-used} / {size-total} ({size-percentage})",
    },
    {
      "type": "battery",
      "key": " 󰂄 Bat",
      "keyColor": "33",
      "format": "{capacity} [{status}]",
    },
    {
      "type": "swap",
      "key": " 󰓡 Swap",
      "keyColor": "33",
      "format": "{used} / {total} ({percentage})",
    },

    {
      "type": "custom",
      "format": "{#90}╰──────────────────────────────────────────────────────────────────╯",
    },

    "break",

    {
      "type": "custom",
      "format": "{#90}╭─ {#38}󰧨 Software {#90}──────────────────────────────────────────────╮",
    },

    {
      "type": "os",
      "key": " 󰣇 OS",
      "keyColor": "38",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": " 󰒔 Kernel",
      "keyColor": "38",
      "format": "{release}",
    },
    {
      "type": "packages",
      "key": " 󰏖 Pkgs",
      "keyColor": "38",
      "combined": true,
    },
    {
      "type": "shell",
      "key": "  Shell",
      "keyColor": "38",
      "format": "{pretty-name} {version}",
    },

    {
      "type": "custom",
      "format": "",
    },

    {
      "type": "command",
      "key": " 󰕮 Sess",
      "keyColor": "38",
      "text": "printf '%s' \"${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-unknown}}\"",
    },
    {
      "type": "wm",
      "key": "  WM",
      "keyColor": "38",
      "format": "{pretty-name}",
    },
    {
      "type": "terminal",
      "key": "  Term",
      "keyColor": "38",
      "format": "{pretty-name}",
    },
    {
      "type": "theme",
      "key": " 󰉼 Theme",
      "keyColor": "38",
    },
    {
      "type": "icons",
      "key": " 󰀻 Icons",
      "keyColor": "38",
    },
    {
      "type": "cursor",
      "key": " 󰳽 Curs",
      "keyColor": "38",
      "format": "{theme}",
    },
    {
      "type": "font",
      "key": " 󰛖 Font",
      "keyColor": "38",
      "format": "{2}",
    },

    {
      "type": "custom",
      "format": "{#90}╰──────────────────────────────────────────────────────────────────╯",
    },

    "break",

    {
      "type": "custom",
      "format": "{#90}╭─ {#35}󰅐 Uptime {#90}────────────────────────────────────────────────╮",
    },

    {
      "type": "command",
      "key": "  Age",
      "keyColor": "35",
      "text": "birth=$(stat -c %W / 2>/dev/null); now=$(date +%s); if [ \"$birth\" -gt 0 ]; then echo \"$(( (now - birth) / 86400 )) days\"; else echo \"unknown\"; fi",
    },
    {
      "type": "uptime",
      "key": "  Up",
      "keyColor": "35",
      "format": "{days}d {hours}h {minutes}m",
    },

    {
      "type": "custom",
      "format": "{#90}╰──────────────────────────────────────────────────────────────────╯",
    },

    "break",

    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
