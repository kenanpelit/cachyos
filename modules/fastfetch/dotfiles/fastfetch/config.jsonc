{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "cachyos",
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "",
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "freq": {
      "ndigits": 0
    },
    "percent": {
      "type": 1
    },
    "key": {
      "width": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "35",
        "host": "36"
      }
    },
    {
      "type": "separator",
      "string": "▔"
    },
    {
      "type": "custom",
      "format": "{#35}System"
    },
    {
      "type": "os",
      "key": "╭─󰣇 ",
      "format": "{pretty-name} ({arch})",
      "keyColor": "35"
    },
    {
      "type": "host",
      "key": "├─󰟀 ",
      "format": "{name} ({family})",
      "keyColor": "35"
    },
    {
      "type": "kernel",
      "key": "├─󰒔 ",
      "format": "{release}",
      "keyColor": "35"
    },
    {
      "type": "packages",
      "key": "├─󰏖 ",
      "combined": true,
      "keyColor": "35"
    },
    {
      "type": "uptime",
      "key": "╰─󰔚 ",
      "keyColor": "35"
    },
    "break",
    {
      "type": "custom",
      "format": "{#38}Session"
    },
    {
      "type": "command",
      "key": "╭─󱂬 ",
      "text": "printf '%s\\n' \"${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-unknown}}\"",
      "format": "{}",
      "keyColor": "38"
    },
    {
      "type": "wm",
      "key": "├─ ",
      "format": "{pretty-name} ({protocol-name})",
      "keyColor": "38"
    },
    {
      "type": "terminal",
      "key": "├─ ",
      "format": "{pretty-name} {version}",
      "keyColor": "38"
    },
    {
      "type": "shell",
      "key": "├─ ",
      "format": "{pretty-name} {version}",
      "keyColor": "38"
    },
    {
      "type": "theme",
      "key": "├─󰉼 ",
      "keyColor": "38"
    },
    {
      "type": "icons",
      "key": "├─󰀻 ",
      "keyColor": "38"
    },
    {
      "type": "cursor",
      "key": "├─󰳽 ",
      "format": "{theme} ({size}px)",
      "keyColor": "38"
    },
    {
      "type": "font",
      "key": "╰─󰛖 ",
      "format": "{2}",
      "keyColor": "38"
    },
    "break",
    {
      "type": "custom",
      "format": "{#33}Hardware"
    },
    {
      "type": "cpu",
      "key": "╭─󰻠 ",
      "format": "{name} ({cores-physical}C/{cores-logical}T)",
      "keyColor": "33"
    },
    {
      "type": "gpu",
      "key": "├─󰍛 ",
      "format": "{name}",
      "keyColor": "33"
    },
    {
      "type": "memory",
      "key": "├─󰑭 ",
      "format": "{used} / {total} ({percentage})",
      "keyColor": "33"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "├─ ",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "keyColor": "33"
    },
    {
      "type": "battery",
      "key": "├─󰂄 ",
      "keyColor": "33"
    },
    {
      "type": "display",
      "key": "╰─󰹑 ",
      "compactType": "original",
      "format": "{width}x{height} @ {refresh-rate}Hz",
      "keyColor": "33"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
