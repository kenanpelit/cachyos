#!/usr/bin/env bash
set -euo pipefail

# Force GTK UI to use daemon config directory so both share:
# - settings.json
# - blocklists generated by osc-blocklist.sh
cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/transmission-daemon"

mkdir -p "${cfg_dir}/blocklists"

exec /usr/bin/transmission-gtk --config-dir "${cfg_dir}" "$@"
