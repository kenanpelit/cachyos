[Unit]
Description=Sunsetr blue-light and gamma filter with integrated scheduler
Documentation=https://github.com/psi4j/sunsetr?tab=readme-ov-file#sunsetr
BindsTo=graphical-session.target
After=graphical-session.target dbus.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=/usr/bin/sunsetr
ConditionPathExists=%h/.config/sunsetr/schedule.conf
ConditionPathExists=%h/.config/sunsetr/sunsetr.toml
ConditionPathExists=%h/.local/bin/sunsetr-set

[Service]
Type=simple
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Start the daemon and a background loop for scheduling
ExecStartPre=-/usr/bin/sunsetr stop
ExecStartPre=%h/.local/bin/sunsetr-set auto --no-notify
ExecStart=/usr/bin/bash -c '\
  /usr/bin/sunsetr & \
  SUNSETR_PID=$!; \
  echo "Sunsetr daemon started with PID $SUNSETR_PID"; \
  while true; do \
    sleep 60; \
    if ! kill -0 $SUNSETR_PID 2>/dev/null; then \
      echo "Sunsetr daemon died, exiting scheduler loop"; \
      exit 1; \
    fi; \
    %h/.local/bin/sunsetr-set auto --apply --no-notify; \
  done'

Restart=on-failure
RestartSec=10
Slice=background.slice
StandardOutput=journal
StandardError=journal
ConfigurationDirectory=sunsetr
ConfigurationDirectoryMode=0755

[Install]
WantedBy=graphical-session.target
