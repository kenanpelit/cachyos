[Unit]
Description=Sunsetr blue-light and gamma filter
Documentation=https://github.com/psi4j/sunsetr?tab=readme-ov-file#sunsetr
BindsTo=graphical-session.target
After=graphical-session.target niri-session-env.service hypr-session-env.service dbus.service
PartOf=graphical-session.target niri-session.target hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=forking
Environment=PATH=/usr/bin:/usr/local/bin:%h/.local/bin
Environment=HOME=%h
ExecStartPre=-/usr/bin/sunsetr stop
ExecStart=/usr/bin/sunsetr -b
ExecStartPost=/usr/bin/bash -c '%h/.local/bin/sunsetr-scheduler-loop &'

Restart=on-failure
RestartSec=10
Slice=background.slice

[Install]
WantedBy=graphical-session.target
WantedBy=niri-session.target
WantedBy=hyprland-session.target
