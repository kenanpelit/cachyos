[Unit]
Description=Start sunsetr units for the Niri session
After=niri-daemons.target
PartOf=niri-post-daemons.target niri-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=/usr/bin/sunsetr
ConditionPathExists=%h/.config/systemd/user/sunsetr-auto-profile.timer

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl --user start sunsetr.service sunsetr-auto-profile.timer
ExecStop=/usr/bin/systemctl --user stop sunsetr-auto-profile.timer sunsetr.service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=niri-post-daemons.target
