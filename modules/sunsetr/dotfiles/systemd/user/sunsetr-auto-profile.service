[Unit]
Description=Apply the scheduled sunsetr preset for the current time
After=graphical-session.target sunsetr.service
BindsTo=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri
ConditionPathExists=%h/.local/bin/sunsetr-set
ConditionPathExists=%h/.config/sunsetr/schedule.conf

[Service]
Type=oneshot
ExecStart=%h/.local/bin/sunsetr-set auto --apply --no-notify
