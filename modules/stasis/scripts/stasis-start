#!/usr/bin/env bash
set -euo pipefail

refresh_from_systemd_env() {
  command -v systemctl >/dev/null 2>&1 || return 0

  local line key val
  while IFS= read -r line; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      NIRI_SOCKET|WAYLAND_DISPLAY|XDG_CURRENT_DESKTOP)
        export "${key}=${val}"
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)
}

in_niri_session() {
  [[ -n "${NIRI_SOCKET:-}" ]] && return 0
  [[ "${XDG_CURRENT_DESKTOP:-}" =~ [Nn][Ii][Rr][Ii] ]] && return 0
  systemctl --user is-active --quiet niri-session.target >/dev/null 2>&1 && return 0
  return 1
}

wait_for_niri_ipc() {
  command -v niri >/dev/null 2>&1 || return 0
  refresh_from_systemd_env
  in_niri_session || return 0

  local max_wait_sec="${STASIS_NIRI_WAIT_SEC:-30}"
  local sleep_step_sec="0.2"
  local max_iters

  if ! [[ "$max_wait_sec" =~ ^[0-9]+$ ]]; then
    max_wait_sec=30
  fi
  (( max_wait_sec > 0 )) || max_wait_sec=30

  max_iters=$((max_wait_sec * 5))

  local i
  for ((i = 0; i < max_iters; i++)); do
    refresh_from_systemd_env
    if [[ -n "${NIRI_SOCKET:-}" ]] && niri msg version >/dev/null 2>&1; then
      return 0
    fi
    sleep "$sleep_step_sec"
  done

  echo "stasis-start: niri IPC not ready after ${max_wait_sec}s; deferring start." >&2
  return 1
}

resolve_session_id() {
  [[ -n "${XDG_SESSION_ID:-}" ]] && return 0
  command -v loginctl >/dev/null 2>&1 || return 0

  local user sid out name type active
  user="${USER:-$(id -un)}"

  while read -r sid _; do
    [[ -n "${sid:-}" ]] || continue
    out="$(loginctl show-session "$sid" -p Name -p User -p Type -p Active --value 2>/dev/null || true)"
    [[ -n "$out" ]] || continue

    name="$(printf '%s\n' "$out" | sed -n '1p')"
    type="$(printf '%s\n' "$out" | sed -n '3p')"
    active="$(printf '%s\n' "$out" | sed -n '4p')"

    if [[ "$name" == "$user" && "$type" == "wayland" && "$active" == "yes" ]]; then
      export XDG_SESSION_ID="$sid"
      return 0
    fi
  done < <(loginctl --no-legend list-sessions 2>/dev/null || true)
}

resolve_session_id
wait_for_niri_ipc

# Stasis on systemd --user can emit a noisy, non-fatal logind probe warning:
# "logind liveness probe failed ... NoSessionForPID".
# Keep output clean by filtering only that specific line.
exec stasis "$@" \
  > >(awk '!(index($0,"logind liveness probe failed:") && index($0,"NoSessionForPID")) { print; fflush() }') \
  2> >(awk '!(index($0,"logind liveness probe failed:") && index($0,"NoSessionForPID")) { print > "/dev/stderr"; fflush("/dev/stderr") }')
