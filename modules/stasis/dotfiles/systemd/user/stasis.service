[Unit]
Description=Stasis (Wayland idle manager)
After=graphical-session.target niri-session.target niri-bootstrap.service hyprland-session.target
PartOf=graphical-session.target niri-session.target hyprland-session.target

[Service]
Type=simple
CPUWeight=20
IOWeight=20
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Environment=STASIS_NIRI_WAIT_SEC=30
ExecStart=%h/.local/bin/stasis-start --verbose --config %h/.config/stasis/stasis.rune
ExecReload=%h/.local/bin/stasis-start --verbose --config %h/.config/stasis/stasis.rune reload
Restart=on-failure
RestartSec=2
