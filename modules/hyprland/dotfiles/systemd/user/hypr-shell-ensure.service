[Unit]
Description=Hyprland shell backend ensure
After=hypr-bootstrap.service dbus.service
Before=hypr-status-notifier-ready.service
PartOf=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/osc-shell

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=OSC_SHELL_STARTUP=1
ExecStart=%h/.local/bin/osc-shell ensure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
