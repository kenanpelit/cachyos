[Unit]
Description=Hyprland status notifier watcher readiness gate
After=graphical-session.target hypr-bootstrap.service dbus.service
PartOf=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/hypr-status-notifier-ready

[Service]
Type=oneshot
TimeoutStartSec=25
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/hypr-status-notifier-ready
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
