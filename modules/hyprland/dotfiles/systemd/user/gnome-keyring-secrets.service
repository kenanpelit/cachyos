[Unit]
Description=GNOME Keyring Secret Service - Hyprland Only
After=hypr-bootstrap.service dbus.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStart=/usr/bin/gnome-keyring-daemon --foreground --components=secrets
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
