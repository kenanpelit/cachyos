[Unit]
Description=GNOME Keyring Secret/PKCS#11 Service - Hyprland Only
After=hypr-bootstrap.service dbus.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
ExecStartPre=/usr/bin/bash -lc 'pkill -u "$(id -u)" -f "^/usr/bin/gnome-keyring-daemon --unlock$" >/dev/null 2>&1 || true'
ExecStart=/usr/bin/gnome-keyring-daemon --replace --foreground --components=secrets,pkcs11
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
