[Unit]
Description=Hyprland desktop settings sync
After=hypr-daemons.target hypr-audio-init.service dbus.service
PartOf=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/hypr-desktop-settings

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/hypr-desktop-settings
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
