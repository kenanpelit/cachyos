[Unit]
Description=Hyprland audio initialization
Wants=pipewire.service wireplumber.service
After=hypr-bootstrap.service pipewire.service wireplumber.service
PartOf=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/osc-soundctl

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
Environment=TERM=dumb
ExecStart=%h/.local/bin/osc-soundctl init
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
