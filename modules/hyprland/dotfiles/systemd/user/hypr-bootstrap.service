[Unit]
Description=Hyprland bootstrap (init)
After=graphical-session.target wayland-wm@start\x2dhyprland.service wayland-session-waitenv.service hypr-session-env.service
Before=hypr-daemons.target
PartOf=hyprland-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/hypr-bootstrap

[Service]
Type=oneshot
TimeoutStartSec=60
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/hypr-bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
