[Unit]
Description=Pyprland daemon (Hyprland)
After=hypr-bootstrap.service dbus.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.config/hypr/pyprland.toml

[Service]
Type=simple
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStartPre=/usr/bin/bash -lc 'runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"; sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"; [[ -n "$sig" ]] || exit 0; rm -f "$runtime_dir/hypr/$sig/.pyprland.sock" "/tmp/hypr/$sig/.pyprland.sock" 2>/dev/null || true'
ExecStart=/usr/bin/pypr --config %h/.config/hypr/pyprland.toml
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
