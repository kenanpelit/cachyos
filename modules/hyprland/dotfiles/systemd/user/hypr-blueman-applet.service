[Unit]
Description=Blueman applet (Hyprland)
After=hypr-bootstrap.service dbus.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
Type=simple
Environment="BLUEMAN_PLUGIN_LIST=['!TransferService', '!GameControllerWakelock', '!PPPSupport', '!DhcpClient']"
Environment=GDK_BACKEND=wayland,x11
ExecStartPre=/usr/bin/sh -lc 'command -v dconf >/dev/null 2>&1 && dconf write /org/blueman/general/plugin-list "$BLUEMAN_PLUGIN_LIST" >/dev/null 2>&1 || true'
ExecStart=%h/.local/bin/hypr-blueman-applet
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
