[Unit]
Description=wl-clip-persist (hyprland)
After=hypr-bootstrap.service
PartOf=hypr-daemons.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=/usr/bin/wl-clip-persist --clipboard both
SuccessExitStatus=1
Restart=on-abnormal
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
