[Unit]
Description=NetworkManager applet (Hyprland)
After=graphical-session.target hypr-bootstrap.service dbus.service
PartOf=hypr-daemons.target graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland

[Service]
ExecStart=/usr/bin/nm-applet --indicator
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hypr-daemons.target
