[Unit]
Description=Hyprland post-bootstrap polish
After=hypr-bootstrap.service dbus.service hyprland-polkit-agent.service hypr-nm-applet.service hypr-blueman-applet.service hypr-clip-persist.service gnome-keyring-secrets.service
PartOf=hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=XDG_CURRENT_DESKTOP=Hyprland
ConditionPathExists=%h/.local/bin/hypr-post-bootstrap

[Service]
Type=oneshot
TimeoutStartSec=30
RemainAfterExit=yes
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin:%h/bin
ExecStart=%h/.local/bin/hypr-post-bootstrap
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=hyprland-session.target
