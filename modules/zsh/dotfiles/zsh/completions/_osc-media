#compdef osc-media osc-media.sh

_osc_media() {
  emulate -L zsh

  local context state line
  local -a commands players first_words

  commands=(
    'toggle:play or pause the active player'
    'play:start playback'
    'pause:pause playback'
    'stop:stop playback'
    'next:skip to the next track'
    'prev:go to the previous track'
    'previous:go to the previous track'
    'status:show the active player status'
  )

  players=(
    'spotify:target Spotify explicitly'
    'vlc:target VLC explicitly'
    'mpv:target MPV via IPC socket'
    'mpd:target MPD explicitly'
    'mpc:alias for MPD'
    'browser:target browser-backed MPRIS players'
  )
  first_words=("${players[@]}" "${commands[@]}")

  _arguments -C \
    '(-h --help)'{-h,--help}'[show osc-media help]' \
    '1:player or command:->first' \
    '2:command:->second' \
    '*::argument:->rest'

  case "$state" in
    first)
      _describe -t osc-media-first 'player or command' first_words
      ;;
    second)
      case "${words[2]:-}" in
        spotify|vlc|mpv|mpd|mpc|browser)
          _describe -t osc-media-command 'command' commands
          ;;
        *)
          _message 'no additional arguments'
          ;;
      esac
      ;;
    rest)
      _message 'no additional arguments'
      ;;
  esac
}

_osc_media "$@"
