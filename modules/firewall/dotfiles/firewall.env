# /etc/ufw/firewall.env
SSH_PORT=22
ALLOW_TRANSMISSION_PORTS=0
ALLOW_CUSTOM_SERVICE_PORT=0
CUSTOM_SERVICE_PORT=1401
TRANSMISSION_WEB_PORT=9091
TRANSMISSION_PEER_PORT=51413
ALLOW_VALENT_PORTS=1
VALENT_PORT_RANGE=1714:1764
# Optional LAN restriction (comma or whitespace separated CIDRs).
# Leave empty to allow Valent/KDE Connect protocol ports from any source.
VALENT_ALLOWED_SUBNETS=192.168.0.0/24
ALLOW_MDNS_PORT=1
MDNS_PORT=5353
# Audiobookshelf (rootless podman, ~/.podman/abs.sh) — phone access over LAN.
ALLOW_AUDIOBOOKSHELF_PORT=1
AUDIOBOOKSHELF_PORT=13378
# Same LAN-restriction semantics as VALENT_ALLOWED_SUBNETS; empty = any source.
AUDIOBOOKSHELF_ALLOWED_SUBNETS=192.168.0.0/24
